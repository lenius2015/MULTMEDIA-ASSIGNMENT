<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OMUNJU SHOPPERS - Your Premier E-Commerce Destination</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <!-- Notification Bar -->
  <div class="notification-bar">
    <div class="notification-content">
      <i class="fas fa-shipping-fast"></i>
      <span>Free shipping on orders above Tsh 50,000 | Use code: OMUNJU01</span>
    </div>
  </div>

  <!-- Navigation Bar -->
  <header class="navbar-header">
    <nav class="navbar">
      <div class="nav-container">
        <!-- Logo -->
        <div class="logo">
          <i class="fas fa-shopping-bag logo-icon"></i>
          <div class="logo-text">
            <span class="logo-main">OMUNJU</span>
            <span class="logo-sub">SHOPPERS</span>
          </div>
        </div>

        <!-- Search Bar -->
        <div class="search-bar">
          <select class="search-category">
            <option value="all">All Categories</option>
            <option value="electronics">Electronics</option>
            <option value="fashion">Fashion</option>
            <option value="home">Home & Garden</option>
            <option value="sports">Sports</option>
            <option value="beauty">Beauty</option>
          </select>
          <input type="text" id="globalSearch" placeholder="Search for products, brands and more..." aria-label="Search products">
          <button type="button" id="searchBtn" aria-label="Search">
            <i class="fas fa-search"></i>
          </button>
        </div>

        <!-- Mobile Hamburger -->
        <div class="hamburger" id="hamburger">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <!-- Navigation Links -->
        <ul class="nav-links" id="navLinks">
          <li><a href="/" class="active"><i class="fas fa-home"></i> Home</a></li>
          <li><a href="/categories"><i class="fas fa-th-large"></i> Categories</a></li>
          <li><a href="/deals"><i class="fas fa-fire"></i> Deals</a></li>
          <li><a href="/promotions"><i class="fas fa-tags"></i> Promotions</a></li>
          <li><a href="/auctions"><i class="fas fa-gavel"></i> Auctions</a></li>
          <li><a href="/about"><i class="fas fa-info-circle"></i> About Us</a></li>
          <li><a href="/contact"><i class="fas fa-envelope"></i> Contact</a></li>
          <% if (user) { %>
          <li><a href="/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
          <% } %>
        </ul>

        <!-- Right Side Icons -->
        <div class="nav-icons">
          <% if (user) { %>
            <a href="/notifications" class="nav-icon-link" title="Notifications" style="position: relative;">
              <i class="fas fa-bell"></i>
              <span class="icon-label">Notifications</span>
              <span class="notification-badge" id="notificationBadge" style="display: none;"></span>
            </a>
            <a href="/profile" class="nav-icon-link" title="My Account">
              <img src="<%= user.profile_picture ? user.profile_picture : '/images/default-avatar.png' %>" alt="Profile" class="nav-profile-picture" style="width: 28px; height: 28px; border-radius: 50%; object-fit: cover;">
              <span class="icon-label">Account</span>
            </a>
          <% } else { %>
            <a href="/login" class="nav-icon-link" title="Login">
              <i class="fas fa-user"></i>
              <span class="icon-label">Login</span>
            </a>
          <% } %>
          
          <a href="/cart" class="nav-icon-link cart-icon" title="Shopping Cart">
            <i class="fas fa-shopping-cart"></i>
            <span class="cart-badge">0</span>
            <span class="icon-label">Cart</span>
          </a>
        </div>
      </div>
    </nav>

    <!-- Secondary Navigation -->
    <div class="secondary-nav">
      <div class="nav-container">
        <div class="category-menu">
          <button class="category-menu-btn">
            <i class="fas fa-bars"></i>
            All Categories
          </button>
          <div class="category-dropdown">
            <a href="/category/electronics" class="category-dropdown-item">
              <i class="fas fa-laptop"></i> Electronics
            </a>
            <a href="/category/fashion" class="category-dropdown-item">
              <i class="fas fa-tshirt"></i> Fashion & Apparel
            </a>
            <a href="/category/home" class="category-dropdown-item">
              <i class="fas fa-home"></i> Home & Garden
            </a>
            <a href="/category/sports" class="category-dropdown-item">
              <i class="fas fa-dumbbell"></i> Sports & Outdoors
            </a>
            <a href="/category/beauty" class="category-dropdown-item">
              <i class="fas fa-spa"></i> Beauty & Health
            </a>
            <a href="/category/baby" class="category-dropdown-item">
              <i class="fas fa-baby"></i> Baby & Kids
            </a>
            <a href="/category/books" class="category-dropdown-item">
              <i class="fas fa-book"></i> Books & Media
            </a>
            <a href="/category/toys" class="category-dropdown-item">
              <i class="fas fa-gamepad"></i> Toys & Games
            </a>
          </div>
        </div>
        <div class="quick-links">
          <a href="#deals">Today's Deals</a>
          <a href="#new">New Arrivals</a>
          <a href="#trending">Trending</a>
          <a href="#bestsellers">Best Sellers</a>
        </div>
      </div>
    </div>
  </header>

  <!-- Hero Section with Slider -->
  <section class="hero-slider" id="home">
    <div class="slider-container">
      <div class="slider-wrapper">
        <!-- Slide 1 -->
        <div class="slider-item active" style="background: linear-gradient(135deg, #ff6b35 0%, #004e89 100%);">
          <div class="slider-content">
            <div class="slider-text">
              <span class="slider-badge">MEGA SALE</span>
              <h1 class="slider-title">Summer Collection 2026</h1>
              <p class="slider-subtitle">Up to 70% OFF on selected items</p>
              <button class="cta-button">
                Shop Now
                <i class="fas fa-arrow-right"></i>
              </button>
            </div>
            <div class="slider-image">
              <img src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=600&h=600&fit=crop" alt="Shopping">
            </div>
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="slider-item" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
          <div class="slider-content">
            <div class="slider-text">
              <span class="slider-badge">NEW ARRIVAL</span>
              <h1 class="slider-title">Latest Electronics</h1>
              <p class="slider-subtitle">Discover cutting-edge technology</p>
              <button class="cta-button">
                View Deals
                <i class="fas fa-arrow-right"></i>
              </button>
            </div>
            <div class="slider-image">
              <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&h=600&fit=crop" alt="Electronics">
            </div>
          </div>
        </div>

        <!-- Slide 3 -->
        <div class="slider-item" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
          <div class="slider-content">
            <div class="slider-text">
              <span class="slider-badge">EXCLUSIVE</span>
              <h1 class="slider-title">Home Essentials</h1>
              <p class="slider-subtitle">Transform your living space</p>
              <button class="cta-button">
                Explore Now
                <i class="fas fa-arrow-right"></i>
              </button>
            </div>
            <div class="slider-image">
              <img src="https://images.unsplash.com/photo-1484101403633-562f891dc89a?w=600&h=600&fit=crop" alt="Home">
            </div>
          </div>
        </div>
      </div>

      <!-- Slider Controls -->
      <button class="slider-btn slider-prev">
        <i class="fas fa-chevron-left"></i>
      </button>
      <button class="slider-btn slider-next">
        <i class="fas fa-chevron-right"></i>
      </button>

      <!-- Slider Dots -->
      <div class="slider-dots">
        <span class="dot active" data-slide="0"></span>
        <span class="dot" data-slide="1"></span>
        <span class="dot" data-slide="2"></span>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="categories-section" id="categories">
    <div class="container">
      <div class="section-header">
        <h2>Shop by Category</h2>
        <p>Browse through our wide range of product categories</p>
      </div>
      
      <div class="categories-grid">
        <div class="category-card">
          <div class="category-image">
            <img src="https://images.unsplash.com/photo-1498049794561-7780e7231661?w=300&h=300&fit=crop" alt="Electronics">
            <div class="category-overlay">
              <button class="category-btn" onclick="exploreCategory('electronics')">Explore</button>
            </div>
          </div>
          <div class="category-info">
            <h3>Electronics</h3>
            <p>2,450+ items</p>
          </div>
        </div>

        <div class="category-card">
          <div class="category-image">
            <img src="https://images.unsplash.com/photo-1445205170230-053b83016050?w=300&h=300&fit=crop" alt="Fashion">
            <div class="category-overlay">
              <button class="category-btn" onclick="exploreCategory('fashion')">Explore</button>
            </div>
          </div>
          <div class="category-info">
            <h3>Fashion & Apparel</h3>
            <p>5,890+ items</p>
          </div>
        </div>

        <div class="category-card">
          <div class="category-image">
            <img src="https://images.unsplash.com/photo-1556911220-bff31c812dba?w=300&h=300&fit=crop" alt="Home">
            <div class="category-overlay">
              <button class="category-btn" onclick="exploreCategory('home')">Explore</button>
            </div>
          </div>
          <div class="category-info">
            <h3>Home & Garden</h3>
            <p>1,230+ items</p>
          </div>
        </div>

        <div class="category-card">
          <div class="category-image">
            <img src="https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=300&h=300&fit=crop" alt="Sports">
            <div class="category-overlay">
              <button class="category-btn" onclick="exploreCategory('sports')">Explore</button>
            </div>
          </div>
          <div class="category-info">
            <h3>Sports & Outdoors</h3>
            <p>980+ items</p>
          </div>
        </div>

        <div class="category-card">
          <div class="category-image">
            <img src="https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=300&h=300&fit=crop" alt="Beauty">
            <div class="category-overlay">
              <button class="category-btn" onclick="exploreCategory('beauty')">Explore</button>
            </div>
          </div>
          <div class="category-info">
            <h3>Beauty & Health</h3>
            <p>3,450+ items</p>
          </div>
        </div>

        <div class="category-card">
          <div class="category-image">
            <img src="https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?w=300&h=300&fit=crop" alt="Baby">
            <div class="category-overlay">
              <button class="category-btn" onclick="exploreCategory('baby')">Explore</button>
            </div>
          </div>
          <div class="category-info">
            <h3>Baby & Kids</h3>
            <p>1,670+ items</p>
          </div>
        </div>

        <div class="category-card">
          <div class="category-image">
            <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?w=300&h=300&fit=crop" alt="Books">
            <div class="category-overlay">
              <button class="category-btn" onclick="exploreCategory('books')">Explore</button>
            </div>
          </div>
          <div class="category-info">
            <h3>Books & Media</h3>
            <p>890+ items</p>
          </div>
        </div>

        <div class="category-card">
          <div class="category-image">
            <img src="https://images.unsplash.com/photo-1558060370-d644479cb6f7?w=300&h=300&fit=crop" alt="Toys">
            <div class="category-overlay">
              <button class="category-btn" onclick="exploreCategory('toys')">Explore</button>
            </div>
          </div>
          <div class="category-info">
            <h3>Toys & Games</h3>
            <p>2,100+ items</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Account Section -->
  <section class="account-section">
    <div class="container">
      <div class="account-container">
        <% if (user) { %>
          <!-- Logged In User -->
          <div class="account-card logged-in">
            <div class="account-icon">
              <i class="fas fa-user-circle"></i>
            </div>
            <div class="account-content">
              <h3>Welcome back, <%= user.name %>!</h3>
              <p>Manage your account and track your orders</p>
              <div class="account-actions">
                <a href="/dashboard" class="account-btn primary-btn">
                  <i class="fas fa-user-cog"></i>
                  View My Account
                </a>
                <button class="account-btn logout-btn" onclick="logout()">
                  <i class="fas fa-sign-out-alt"></i>
                  Logout
                </button>
              </div>
            </div>
          </div>
        <% } else { %>
          <!-- Not Logged In User -->
          <div class="account-card not-logged-in">
            <div class="account-icon">
              <i class="fas fa-user-plus"></i>
            </div>
            <div class="account-content">
              <h3>Join OMUNJU SHOPPERS</h3>
              <p>Create an account to enjoy personalized shopping, order tracking, and exclusive deals</p>
              <div class="account-actions">
                <a href="/login" class="account-btn primary-btn">
                  <i class="fas fa-sign-in-alt"></i>
                  Login Now
                </a>
                <a href="/signup" class="account-btn secondary-btn">
                  <i class="fas fa-user-plus"></i>
                  Create Account
                </a>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Featured Products Section -->
