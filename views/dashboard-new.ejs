            <div class="modal-header">
                <h3 class="modal-title">New Message</h3>
                <button class="modal-close" onclick="closeMessageModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="messageForm">
                    <div class="form-group">
                        <label class="form-label">Subject</label>
                        <input type="text" class="form-input" id="messageSubject" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Message</label>
                        <textarea class="form-input" id="messageContent" rows="5" required style="resize: vertical;"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline" onclick="closeMessageModal()">Cancel</button>
                <button class="btn btn-primary" onclick="sendMessage()">Send Message</button>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Chat Widget -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="/script.js"></script>
    <script src="/chatbot.js"></script>

    <script>
        // API Base URL
        const API_BASE = '/api/user';

        // State
        let currentPage = 'dashboard';
        let dashboardData = null;

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            loadDashboardData();
            setupNavigation();
            setupForms();
            loadCartCount();
        });

        // Navigation
        function setupNavigation() {
            const navItems = document.querySelectorAll('[data-page]');
            navItems.forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const page = this.dataset.page;
                    navigateTo(page);
                });
            });

            // Menu toggle
            document.getElementById('menuToggle').addEventListener('click', function() {
                document.getElementById('sidebar').classList.toggle('open');
            });

            // Close sidebar on outside click
            document.addEventListener('click', function(e) {
                const sidebar = document.getElementById('sidebar');
                const menuToggle = document.getElementById('menuToggle');
                if (!sidebar.contains(e.target) && !menuToggle.contains(e.target)) {
                    sidebar.classList.remove('open');
                }
            });

            // Mark all notifications read
            document.getElementById('markAllReadBtn')?.addEventListener('click', function() {
                markAllNotificationsRead();
            });

            // New message button
            document.getElementById('newMessageBtn')?.addEventListener('click', function() {
                document.getElementById('messageModal').classList.add('open');
            });

            // Add address button
            document.getElementById('addAddressBtn')?.addEventListener('click', function() {
                document.getElementById('addressModal').classList.add('open');
            });
        }

        function navigateTo(page) {
            currentPage = page;

            // Update nav items
            document.querySelectorAll('.nav-item').forEach(item => {
                item.classList.remove('active');
                if (item.dataset.page === page) {
                    item.classList.add('active');
                }
            });

            // Update page title
            const titles = {
                dashboard: 'Dashboard',
                orders: 'My Orders',
                wishlist: 'Wishlist',
                invoices: 'Invoices & Payments',
                messages: 'Messages',
                notifications: 'Notifications',
                profile: 'Profile Settings',
                addresses: 'Addresses',
                security: 'Security',
                help: 'Help Center'
            };
            document.getElementById('pageTitle').textContent = titles[page] || 'Dashboard';

            // Show/hide sections
            document.querySelectorAll('.page-section').forEach(section => {
                section.classList.remove('active');
            });
            document.getElementById('section-' + page)?.classList.add('active');

            // Close sidebar on mobile
            document.getElementById('sidebar').classList.remove('open');

            // Load data for page
            loadPageData(page);
        }

        // Load Dashboard Data
        async function loadDashboardData() {
            try {
                const response = await fetch(API_BASE + '/dashboard/stats');
                const data = await response.json();

                if (data.success) {
                    dashboardData = data.data;
                    renderDashboardStats(data.data);
                    renderRecentOrders(data.data.recentOrders || []);
                    updateBadges(data.data);
                }
            } catch (error) {
                console.error('Error loading dashboard:', error);
            }
        }

        function renderDashboardStats(data) {
            document.getElementById('statOrders').textContent = data.orders?.total_orders || 0;
            document.getElementById('statPending').textContent = data.orders?.pending_orders || 0;
            document.getElementById('statDelivered').textContent = data.orders?.delivered_orders || 0;
            document.getElementById('statWishlist').textContent = data.wishlistCount || 0;
        }

        function updateBadges(data) {
            const ordersBadge = document.getElementById('ordersBadge');
            const messagesBadge = document.getElementById('messagesBadge');
            const notificationsBadge = document.getElementById('notificationsBadge');
            const headerNotificationBadge = document.getElementById('headerNotificationBadge');

            if (data.orders?.pending_orders > 0) {
                ordersBadge.textContent = data.orders.pending_orders;
                ordersBadge.style.display = 'inline-flex';
            }

            if (data.unreadMessages > 0) {
                messagesBadge.textContent = data.unreadMessages;
                messagesBadge.style.display = 'inline-flex';
            }

            if (data.unreadNotifications > 0) {
                notificationsBadge.textContent = data.unreadNotifications;
                notificationsBadge.style.display = 'inline-flex';
                headerNotificationBadge.textContent = data.unreadNotifications;
                headerNotificationBadge.style.display = 'inline-flex';
            }
        }

        function renderRecentOrders(orders) {
            const container = document.getElementById('recentOrdersList');

            if (!orders || orders.length === 0) {
                return;
            }

            container.innerHTML = orders.map(order => `
                <div class="order-item">
                    <div class="order-info">
                        <div class="order-number">${order.order_number}</div>
                        <div class="order-date">${new Date(order.created_at).toLocaleDateString()}</div>
                        <span class="order-status ${order.status}">${capitalizeFirst(order.status)}</span>
                    </div>
                    <div class="order-amount">
                        <div class="order-total">KSh ${parseFloat(order.final_amount).toLocaleString()}</div>
                        <div class="order-actions">
                            <button class="btn btn-outline btn-sm" onclick="viewOrder(${order.id})">View Details</button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Load Page Data
        function loadPageData(page) {
            switch (page) {
                case 'orders':
                    loadOrders();
                    break;
                case 'wishlist':
                    loadWishlist();
                    break;
                case 'invoices':
                    loadInvoices();
                    break;
                case 'messages':
                    loadConversations();
                    break;
                case 'notifications':
                    loadNotifications();
                    break;
                case 'addresses':
                    loadAddresses();
                    break;
                case 'security':
                    loadLoginActivity();
                    break;
            }
        }

        // Orders
        async function loadOrders(status = '') {
            try {
                let url = API_BASE + '/orders?limit=20';
                if (status) url += '&status=' + status;

                const response = await fetch(url);
                const data = await response.json();

                if (data.success) {
                    renderOrders(data.data);
                }
            } catch (error) {
                console.error('Error loading orders:', error);
            }
        }

        function renderOrders(orders) {
            const container = document.getElementById('ordersList');

            if (!orders || orders.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon"><i class="fas fa-shopping-bag"></i></div>
                        <h3 class="empty-title">No orders found</h3>
                        <p class="empty-text">When you place orders, they will appear here</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = orders.map(order => `
                <div class="order-item">
                    <div class="order-info">
                        <div class="order-number">${order.order_number}</div>
                        <div class="order-date">${new Date(order.created_at).toLocaleDateString()}</div>
                        <span class="order-status ${order.status}">${capitalizeFirst(order.status)}</span>
                        <span class="order-status ${order.payment_status}" style="margin-left: 8px;">${capitalizeFirst(order.payment_status)}</span>
                    </div>
                    <div class="order-amount">
                        <div class="order-total">KSh ${parseFloat(order.final_amount).toLocaleString()}</div>
                        <div class="order-actions">
                            <button class="btn btn-outline btn-sm" onclick="viewOrder(${order.id})">View Details</button>
                            ${['pending', 'confirmed'].includes(order.status) ? `<button class="btn btn-outline btn-sm" style="color: var(--danger);" onclick="cancelOrder(${order.id})">Cancel</button>` : ''}
                        </div>
                    </div>
                </div>
            `).join('');
        }

        document.getElementById('orderStatusFilter')?.addEventListener('change', function() {
            loadOrders(this.value);
        });

        function viewOrder(id) {
            window.location.href = '/orders/' + id;
        }

        async function cancelOrder(id) {
            if (!confirm('Are you sure you want to cancel this order?')) return;

            try {
                const response = await fetch(API_BASE + '/orders/' + id + '/cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason: 'Cancelled by customer' })
                });
                const data = await response.json();

                if (data.success) {
                    showToast('Order cancelled successfully', 'success');
                    loadOrders();
                    loadDashboardData();
                } else {
                    showToast(data.message || 'Failed to cancel order', 'error');
                }
            } catch (error) {
                showToast('Error cancelling order', 'error');
            }
        }

        // Wishlist
        async function loadWishlist() {
            try {
                const response = await fetch(API_BASE + '/wishlist');
                const data = await response.json();

                if (data.success) {
                    renderWishlist(data.data);
                }
            } catch (error) {
                console.error('Error loading wishlist:', error);
            }
        }

        function renderWishlist(wishlists) {
            const container = document.getElementById('wishlistGrid');

            const allItems = wishlists.flatMap(w => w.items || []);

            if (allItems.length === 0) {
                container.innerHTML = `
                    <div class="empty-state" style="grid-column: 1 / -1;">
                        <div class="empty-icon"><i class="fas fa-heart"></i></div>
                        <h3 class="empty-title">Your wishlist is empty</h3>
                        <p class="empty-text">Save items you love to your wishlist</p>
                        <a href="/" class="btn btn-primary">Browse Products</a>
                    </div>
                `;
                return;
            }

            container.innerHTML = allItems.map(item => `
                <div class="wishlist-item">
                    <img src="${item.image_url || 'https://via.placeholder.com/220x200'}" alt="${item.name}" class="wishlist-image">
                    <div class="wishlist-details">
                        <h4 class="wishlist-name">${item.name}</h4>
                        <div class="wishlist-price">KSh ${parseFloat(item.price).toLocaleString()}</div>
                        <div class="wishlist-actions">
                            <button class="btn btn-primary btn-sm" onclick="moveToCart(${item.product_id})">
                                <i class="fas fa-shopping-cart"></i> Add to Cart
                            </button>
                            <button class="btn btn-outline btn-sm" onclick="removeFromWishlist(${item.product_id})">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        async function moveToCart(productId) {
            try {
                const response = await fetch('/api/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId, quantity: 1 })
                });
                const data = await response.json();

                if (data.success) {
                    showToast('Added to cart', 'success');
                    loadCartCount();
                } else {
                    showToast(data.message || 'Failed to add to cart', 'error');
                }
            } catch (error) {
                showToast('Error adding to cart', 'error');
            }
        }

        async function removeFromWishlist(productId) {
            try {
                const response = await fetch(API_BASE + '/wishlist/remove/' + productId, {
                    method: 'DELETE'
                });
                const data = await response.json();

                if (data.success) {
                    showToast('Removed from wishlist', 'success');
                    loadWishlist();
                }
            } catch (error) {
                showToast('Error removing from wishlist', 'error');
            }
        }

        // Invoices
        async function loadInvoices() {
            try {
                const response = await fetch(API_BASE + '/invoices');
                const data = await response.json();

                if (data.success) {
                    renderInvoices(data.data);
                }
            } catch (error) {
                console.error('Error loading invoices:', error);
            }
        }

        function renderInvoices(invoices) {
            const container = document.getElementById('invoicesList');

            if (!invoices || invoices.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon"><i class="fas fa-file-invoice"></i></div>
                        <h3 class="empty-title">No invoices yet</h3>
                        <p class="empty-text">Your invoices will appear here after orders</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = invoices.map(inv => `
                <div class="order-item">
                    <div class="order-info">
                        <div class="order-number">${inv.invoice_number}</div>
                        <div class="order-date">${new Date(inv.invoice_date).toLocaleDateString()}</div>
                        <span class="order-status ${inv.status}">${capitalizeFirst(inv.status)}</span>
                    </div>
                    <div class="order-amount">
                        <div class="order-total">KSh ${parseFloat(inv.total_amount).toLocaleString()}</div>
                        <div class="order-actions">
                            <button class="btn btn-outline btn-sm" onclick="viewInvoice(${inv.id})">
                                <i class="fas fa-eye"></i> View
                            </button>
                            <button class="btn btn-outline btn-sm" onclick="downloadInvoice(${inv.id})">
                                <i class="fas fa-download"></i> Download
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function viewInvoice(id) {
            window.location.href = '/invoices/' + id;
        }

        function downloadInvoice(id) {
            showToast('Downloading invoice...', 'info');
        }

        // Messages
        async function loadConversations() {
            try {
                const response = await fetch(API_BASE + '/conversations');
                const data = await response.json();

                if (data.success) {
                    renderConversations(data.data);
                }
            } catch (error) {
                console.error('Error loading conversations:', error);
            }
        }

        function renderConversations(conversations) {
            const container = document.getElementById('conversationsList');

            if (!conversations || conversations.length === 0) {
                return;
            }

            container.innerHTML = conversations.map(conv => `
                <div class="conversation-item ${conv.status === 'open' && hasUnreadMessages(conv) ? 'unread' : ''}" onclick="viewConversation(${conv.id})">
                    <div class="conversation-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="conversation-info">
                        <div class="conversation-header">
                            <span class="conversation-subject">${conv.subject || 'Support Conversation'}</span>
                            <span class="conversation-time">${formatTimeAgo(conv.last_message_at)}</span>
                        </div>
                        <div class="conversation-preview">${conv.last_message || 'No messages yet'}</div>
                        <div class="conversation-status">
                            <span class="conversation-badge ${conv.status}">${capitalizeFirst(conv.status)}</span>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function hasUnreadMessages(conv) {
            return false; // Simplified for demo
        }

        function viewConversation(id) {
            window.location.href = '/messages/' + id;
        }

        function startNewConversation() {
            document.getElementById('messageModal').classList.add('open');
        }

        function closeMessageModal() {
            document.getElementById('messageModal').classList.remove('open');
            document.getElementById('messageForm').reset();
        }

        async function sendMessage() {
            const subject = document.getElementById('messageSubject').value;
            const content = document.getElementById('messageContent').value;

            if (!subject || !content) {
                showToast('Please fill in all fields', 'warning');
                return;
            }

            try {
                const response = await fetch(API_BASE + '/conversations', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ subject, message: content })
                });
                const data = await response.json();

                if (data.success) {
                    showToast('Message sent successfully', 'success');
                    closeMessageModal();
                    loadConversations();
                }
            } catch (error) {
                showToast('Error sending message', 'error');
            }
        }

        // Notifications
        async function loadNotifications() {
            try {
                const response = await fetch(API_BASE + '/notifications');
                const data = await response.json();

                if (data.success) {
                    renderNotifications(data.data);
                }
            } catch (error) {
                console.error('Error loading notifications:', error);
            }
        }

        function renderNotifications(notifications) {
            const container = document.getElementById('notificationsList');

            if (!notifications || notifications.length === 0) {
                return;
            }

            container.innerHTML = notifications.map(notif => `
                <div class="notification-item ${notif.is_read ? '' : 'unread'}" onclick="markNotificationRead(${notif.id})">
                    <div class="notification-icon ${getNotificationIconClass(notif.type)}">
                        <i class="${getNotificationIcon(notif.type)}"></i>
                    </div>
                    <div class="notification-content">
                        <div class="notification-title">${notif.title}</div>
                        <div class="notification-message">${notif.message}</div>
                        <div class="notification-time">${formatTimeAgo(notif.created_at)}</div>
                    </div>
                </div>
            `).join('');
        }

        function getNotificationIcon(type) {
            const icons = {
                order_placed: 'fas fa-shopping-bag',
                order_shipped: 'fas fa-truck',
                order_delivered: 'fas fa-check-circle',
                payment_received: 'fas fa-credit-card',
                new_message: 'fas fa-comment',
                promotion: 'fas fa-tag',
                general: 'fas fa-bell'
            };
            return icons[type] || icons.general;
        }

        function getNotificationIconClass(type) {
            const classes = {
                order_placed: 'order',
                order_shipped: 'order',
                order_delivered: 'success',
                payment_received: 'payment',
                promotion: 'promo',
                new_message: 'message'
            };
            return classes[type] || 'system';
        }

        async function markNotificationRead(id) {
            try {
                await fetch(API_BASE + '/notifications/' + id + '/read', { method: 'PUT' });
            } catch (error) {
                console.error('Error marking notification read:', error);
            }
        }

        async function markAllNotificationsRead() {
            try {
                await fetch(API_BASE + '/notifications/read-all', { method: 'PUT' });
                showToast('All notifications marked as read', 'success');
                loadNotifications();
            } catch (error) {
                showToast('Error marking notifications read', 'error');
            }
        }

        // Addresses
        async function loadAddresses() {
            try {
                const response = await fetch(API_BASE + '/addresses');
                const data = await response.json();

                if (data.success) {
                    renderAddresses(data.data);
                }
            } catch (error) {
                console.error('Error loading addresses:', error);
            }
        }

        function renderAddresses(addresses) {
            const container = document.getElementById('addressesGrid');

            if (!addresses || addresses.length === 0) {
                return;
            }

            container.innerHTML = addresses.map(addr => `
                <div class="address-card ${addr.is_default ? 'default' : ''}">
                    <div class="address-header">
                        <div class="address-label">
                            <i class="fas fa-${addr.label === 'home' ? 'home' : addr.label === 'work' ? 'briefcase' : 'map-marker-alt'}"></i>
                            ${capitalizeFirst(addr.label)}
                        </div>
                        <div class="address-actions">
                            <button class="address-action" onclick="editAddress(${addr.id})" title="Edit">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="address-action" onclick="setDefaultAddress(${addr.id})" title="Set Default">
                                <i class="fas fa-star"></i>
                            </button>
                            <button class="address-action delete" onclick="deleteAddress(${addr.id})" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="address-details">
                        <div><i class="fas fa-user"></i> ${addr.full_name}</div>
                        <div><i class="fas fa-phone"></i> ${addr.phone}</div>
                        <div><i class="fas fa-map-marker-alt"></i> ${addr.address_line1}</div>
                        ${addr.address_line2 ? `<div><i class="fas fa-map-marker-alt"></i> ${addr.address_line2}</div>` : ''}
                        <div><i class="fas fa-city"></i> ${addr.city} ${addr.postal_code ? ', ' + addr.postal_code : ''}</div>
                    </div>
                </div>
            `).join('');
        }

        function closeAddressModal() {
            document.getElementById('addressModal').classList.remove('open');
            document.getElementById('addressForm').reset();
        }

        async function saveAddress() {
            const data = {
                label: document.getElementById('addressLabel').value,
                fullName: document.getElementById('addressFullName').value,
                phone: document.getElementById('addressPhone').value,
                addressLine1: document.getElementById('addressLine1').value,
                addressLine2: document.getElementById('addressLine2').value,
                city: document.getElementById('addressCity').value,
                postalCode: document.getElementById('addressPostalCode').value,
                deliveryInstructions: document.getElementById('addressInstructions').value
            };

            if (!data.fullName || !data.phone || !data.addressLine1 || !data.city) {
                showToast('Please fill in all required fields', 'warning');
                return;
            }

            try {
                const response = await fetch(API_BASE + '/addresses', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();

                if (result.success) {
                    showToast('Address added successfully', 'success');
                    closeAddressModal();
                    loadAddresses();
                } else {
                    showToast(result.message || 'Failed to add address', 'error');
                }
            } catch (error) {
                showToast('Error adding address', 'error');
            }
        }

        async function setDefaultAddress(id) {
            try {
                await fetch(API_BASE + '/addresses/' + id + '/default', { method: 'POST' });
                showToast('Default address updated', 'success');
                loadAddresses();
            } catch (error) {
                showToast('Error updating default address', 'error');
            }
        }

        async function deleteAddress(id) {
            if (!confirm('Are you sure you want to delete this address?')) return;

            try {
                await fetch(API_BASE + '/addresses/' + id, { method: 'DELETE' });
                showToast('Address deleted', 'success');
                loadAddresses();
            } catch (error) {
                showToast('Error deleting address', 'error');
            }
        }

        // Security - Login Activity
        async function loadLoginActivity() {
            try {
                const response = await fetch(API_BASE + '/activity');
                const data = await response.json();

                if (data.success) {
                    renderLoginActivity(data.data);
                }
            } catch (error) {
                console.error('Error loading login activity:', error);
            }
        }

        function renderLoginActivity(activity) {
            const container = document.getElementById('loginActivityList');

            if (!activity || activity.length === 0) {
                return;
            }

            container.innerHTML = activity.slice(0, 10).map(item => `
                <div class="order-item">
                    <div class="order-info">
                        <div class="order-number">${item.device_type || 'Unknown Device'}</div>
                        <div class="order-date">${new Date(item.login_time).toLocaleString()}</div>
                        <span class="order-status ${item.is_active ? 'delivered' : 'cancelled'}">${item.is_active ? 'Active' : 'Logged Out'}</span>
                    </div>
                    <div class="order-amount">
                        <div class="order-actions">
                            ${!item.is_active ? '' : `<button class="btn btn-outline btn-sm" onclick="logoutSession('${item.session_token}')">End Session</button>`}
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Forms
        function setupForms() {
            // Profile form
            document.getElementById('profileForm')?.addEventListener('submit', async function(e) {
                e.preventDefault();

                const data = {
                    name: document.getElementById('profileName').value,
                    phone: document.getElementById('profilePhone').value,
                    address: document.getElementById('profileAddress').value
                };

                try {
                    const response = await fetch(API_BASE + '/profile', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();

                    if (result.success) {
                        showToast('Profile updated successfully', 'success');
                        document.getElementById('sidebarUserName').textContent = data.name;
                    } else {
                        showToast(result.message || 'Failed to update profile', 'error');
                    }
                } catch (error) {
                    showToast('Error updating profile', 'error');
                }
            });

            // Password form
            document.getElementById('passwordForm')?.addEventListener('submit', async function(e) {
                e.preventDefault();

                const currentPassword = document.getElementById('currentPassword').value;
                const newPassword = document.getElementById('newPassword').value;
                const confirmPassword = document.getElementById('confirmPassword').value;

                if (newPassword !== confirmPassword) {
                    showToast('New passwords do not match', 'warning');
                    return;
                }

                if (newPassword.length < 6) {
                    showToast('Password must be at least 6 characters', 'warning');
                    return;
                }

                try {
                    const response = await fetch(API_BASE + '/password', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ currentPassword, newPassword })
                    });
                    const result = await response.json();

                    if (result.success) {
                        showToast('Password changed successfully', 'success');
                        this.reset();
                    } else {
                        showToast(result.message || 'Failed to change password', 'error');
                    }
                } catch (error) {
                    showToast('Error changing password', 'error');
                }
            });
        }

        // Cart Count
        async function loadCartCount() {
            try {
                const response = await fetch('/api/cart');
                const data = await response.json();

                if (data.success) {
                    const count = data.items?.length || 0;
                    document.getElementById('cartBadge').textContent = count;
                }
            } catch (error) {
                console.error('Error loading cart count:', error);
            }
        }

        // Utility Functions
        function capitalizeFirst(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }

        function formatTimeAgo(date) {
            const seconds = Math.floor((new Date() - new Date(date)) / 1000);

            if (seconds < 60) return 'Just now';
            if (seconds < 3600) return Math.floor(seconds / 60) + ' min ago';
            if (seconds < 86400) return Math.floor(seconds / 3600) + ' hours ago';
            if (seconds < 604800) return Math.floor(seconds / 86400) + ' days ago';
            return new Date(date).toLocaleDateString();
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = 'toast ' + type;

            const icons = {
                success: 'fas fa-check-circle',
                error: 'fas fa-times-circle',
                warning: 'fas fa-exclamation-circle',
                info: 'fas fa-info-circle'
            };

            toast.innerHTML = `
                <i class="toast-icon ${icons[type]}"></i>
                <span class="toast-message">${message}</span>
                <button class="toast-close" onclick="this.parentElement.remove()">
                    <i class="fas fa-times"></i>
                </button>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 5000);
        }
    </script>
</body>
</html>
