<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Messages Center - OMUNJU SHOPPERS Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/admin.css">
    <style>
        /* Modern Messages Dashboard Styles */
        :root {
            --primary-orange: #ff6b35;
            --primary-blue: #004e89;
            --accent-amber: #f77f00;
            --success-green: #28a745;
            --warning-yellow: #ffc107;
            --error-red: #dc3545;
            --white: #ffffff;
            --light-gray: #f8f9fa;
            --medium-gray: #e9ecef;
            --dark-gray: #495057;
            --darker-gray: #212529;
            --shadow: 0 2px 8px rgba(0,0,0,0.08);
            --shadow-lg: 0 8px 24px rgba(0,0,0,0.12);
            --border-radius: 16px;
            --transition: all 0.3s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--light-gray);
        }

        .messages-container {
            display: flex;
            gap: 24px;
            height: calc(100vh - 120px);
            padding: 24px;
        }

        /* Sidebar Filters */
        .messages-sidebar {
            width: 280px;
            min-width: 280px;
            background: var(--white);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            padding: 24px;
            display: flex;
            flex-direction: column;
        }

        .sidebar-header {
            margin-bottom: 24px;
        }

        .sidebar-header h2 {
            font-size: 1.5rem;
            color: var(--darker-gray);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-header h2 i {
            color: var(--primary-orange);
        }

        .compose-btn {
            width: 100%;
            padding: 14px 20px;
            background: linear-gradient(135deg, var(--primary-orange), var(--accent-amber));
            color: var(--white);
            border: none;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: var(--transition);
            margin-bottom: 24px;
        }

        .compose-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 107, 53, 0.35);
        }

        .filter-section h3 {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #868e96;
            margin-bottom: 12px;
        }

        .filter-list {
            list-style: none;
        }

        .filter-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 10px;
            cursor: pointer;
            transition: var(--transition);
            margin-bottom: 4px;
            color: var(--dark-gray);
        }

        .filter-item:hover {
            background: var(--light-gray);
        }

        .filter-item.active {
            background: rgba(255, 107, 53, 0.1);
            color: var(--primary-orange);
        }

        .filter-item i {
            width: 20px;
            text-align: center;
        }

        .filter-item span {
            flex: 1;
        }

        .filter-count {
            background: var(--light-gray);
            padding: 2px 10px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .filter-item.active .filter-count {
            background: var(--primary-orange);
            color: var(--white);
        }

        /* Main Messages Area */
        .messages-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: var(--white);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .main-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--medium-gray);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(135deg, #ffffff 0%, var(--light-gray) 100%);
        }

        .search-box {
            position: relative;
            flex: 1;
            max-width: 400px;
        }

        .search-box input {
            width: 100%;
            padding: 12px 20px 12px 44px;
            border: 2px solid var(--medium-gray);
            border-radius: 25px;
            font-size: 0.95rem;
            transition: var(--transition);
        }

        .search-box input:focus {
            outline: none;
            border-color: var(--primary-orange);
            box-shadow: 0 0 0 4px rgba(255, 107, 53, 0.1);
        }

        .search-box i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #868e96;
        }

        .header-actions {
            display: flex;
            gap: 12px;
        }

        .action-btn {
            width: 42px;
            height: 42px;
            border: none;
            border-radius: 10px;
            background: var(--light-gray);
            color: var(--dark-gray);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .action-btn:hover {
            background: var(--primary-orange);
            color: var(--white);
        }

        /* Messages List */
        .messages-list {
            flex: 1;
            overflow-y: auto;
        }

        .message-card {
            display: flex;
            align-items: center;
            padding: 20px 24px;
            border-bottom: 1px solid var(--medium-gray);
            cursor: pointer;
            transition: var(--transition);
        }

        .message-card:hover {
            background: var(--light-gray);
        }

        .message-card.active {
            background: rgba(255, 107, 53, 0.08);
            border-left: 4px solid var(--primary-orange);
        }

        .message-card.unread {
            background: rgba(255, 107, 53, 0.03);
        }

        .message-card.unread .message-subject {
            font-weight: 700;
            color: var(--darker-gray);
        }

        .message-avatar {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-blue), #003566);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-weight: 700;
            font-size: 1.2rem;
            margin-right: 16px;
            flex-shrink: 0;
            position: relative;
        }

        .message-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .message-content {
            flex: 1;
            min-width: 0;
        }

        .message-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
        }

        .message-sender {
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--darker-gray);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .online-badge {
            width: 8px;
            height: 8px;
            background: var(--success-green);
            border-radius: 50%;
            box-shadow: 0 0 8px var(--success-green);
        }

        .message-time {
            font-size: 0.8rem;
            color: #868e96;
        }

        .message-subject {
            font-size: 0.9rem;
            color: var(--dark-gray);
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .message-preview {
            font-size: 0.85rem;
            color: #868e96;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .message-actions {
            display: flex;
            gap: 8px;
            opacity: 0;
            transition: var(--transition);
        }

        .message-card:hover .message-actions {
            opacity: 1;
        }

        .msg-action-btn {
            width: 36px;
            height: 36px;
            border: none;
            border-radius: 8px;
            background: var(--white);
            color: #868e96;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .msg-action-btn:hover {
            background: var(--primary-orange);
            color: var(--white);
        }

        .msg-action-btn.delete:hover {
            background: var(--error-red);
        }

        /* Priority Badge */
        .priority-badge {
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            margin-left: 10px;
        }

        .priority-badge.high {
            background: rgba(220, 53, 69, 0.1);
            color: var(--error-red);
        }

        .priority-badge.medium {
            background: rgba(255, 193, 7, 0.1);
            color: #d39e00;
        }

        .priority-badge.low {
            background: rgba(40, 167, 69, 0.1);
            color: var(--success-green);
        }

        /* Empty State */
        .empty-state {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #868e96;
            padding: 60px 20px;
        }

        .empty-state i {
            font-size: 5rem;
            margin-bottom: 24px;
            opacity: 0.3;
            color: var(--primary-orange);
        }

        .empty-state h3 {
            font-size: 1.5rem;
            margin-bottom: 12px;
            color: var(--darker-gray);
        }

        .empty-state p {
            font-size: 1rem;
            opacity: 0.7;
        }

        /* Stats Cards */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: var(--white);
            border-radius: var(--border-radius);
            padding: 20px;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .stat-icon {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .stat-icon.blue {
            background: rgba(0, 78, 137, 0.1);
            color: var(--primary-blue);
        }

        .stat-icon.orange {
            background: rgba(255, 107, 53, 0.1);
            color: var(--primary-orange);
        }

        .stat-icon.green {
            background: rgba(40, 167, 69, 0.1);
            color: var(--success-green);
        }

        .stat-icon.amber {
            background: rgba(247, 127, 0, 0.1);
            color: var(--accent-amber);
        }

        .stat-info h4 {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--darker-gray);
            margin-bottom: 4px;
        }

        .stat-info p {
            font-size: 0.9rem;
            color: #868e96;
        }

        /* Responsive */
        @media (max-width: 1200px) {
            .stats-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 900px) {
            .messages-container {
                flex-direction: column;
                height: auto;
            }

            .messages-sidebar {
                width: 100%;
                min-width: 100%;
            }

            .messages-main {
                min-height: 500px;
            }
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <%- include('./partials/sidebar', { currentPage: 'messages' }) %>
        
        <div class="admin-main">
            <%- include('./partials/header', { pageTitle: 'Messages Center' }) %>
            
            <main class="admin-content">
                <!-- Stats Row -->
                <div class="stats-row">
                    <div class="stat-card">
                        <div class="stat-icon blue">
                            <i class="fas fa-inbox"></i>
                        </div>
                        <div class="stat-info">
                            <h4 id="totalMessages">0</h4>
                            <p>Total Messages</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon orange">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div class="stat-info">
                            <h4 id="unreadMessages">0</h4>
                            <p>Unread</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon green">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="stat-info">
                            <h4 id="resolvedMessages">0</h4>
                            <p>Resolved</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon amber">
                            <i class="fas fa-star"></i>
                        </div>
                        <div class="stat-info">
                            <h4 id="importantMessages">0</h4>
                            <p>Important</p>
                        </div>
                    </div>
                </div>

                <div class="messages-container">
                    <!-- Sidebar -->
                    <div class="messages-sidebar">
                        <div class="sidebar-header">
                            <h2><i class="fas fa-envelope-open-text"></i> Inbox</h2>
                        </div>
                        
                        <button class="compose-btn" onclick="openComposeModal()">
                            <i class="fas fa-pen"></i> Compose New
                        </button>
                        
                        <div class="filter-section">
                            <h3>Filter By</h3>
                            <ul class="filter-list">
                                <li class="filter-item active" onclick="filterMessages('all', this)">
                                    <i class="fas fa-inbox"></i>
                                    <span>All Messages</span>
                                    <span class="filter-count" id="count-all">0</span>
                                </li>
                                <li class="filter-item" onclick="filterMessages('unread', this)">
                                    <i class="fas fa-envelope"></i>
                                    <span>Unread</span>
                                    <span class="filter-count" id="count-unread">0</span>
                                </li>
                                <li class="filter-item" onclick="filterMessages('important', this)">
                                    <i class="fas fa-star"></i>
                                    <span>Important</span>
                                    <span class="filter-count" id="count-important">0</span>
                                </li>
                                <li class="filter-item" onclick="filterMessages('resolved', this)">
                                    <i class="fas fa-check-circle"></i>
                                    <span>Resolved</span>
                                    <span class="filter-count" id="count-resolved">0</span>
                                </li>
                            </ul>
                        </div>
                        
                        <div class="filter-section" style="margin-top: 24px;">
                            <h3>Categories</h3>
                            <ul class="filter-list">
                                <li class="filter-item" onclick="filterMessages('inquiry', this)">
                                    <i class="fas fa-question-circle"></i>
                                    <span>Inquiries</span>
                                    <span class="filter-count" id="count-inquiry">0</span>
                                </li>
                                <li class="filter-item" onclick="filterMessages('support', this)">
                                    <i class="fas fa-headset"></i>
                                    <span>Support</span>
                                    <span class="filter-count" id="count-support">0</span>
                                </li>
                                <li class="filter-item" onclick="filterMessages('feedback', this)">
                                    <i class="fas fa-comment-dots"></i>
                                    <span>Feedback</span>
                                    <span class="filter-count" id="count-feedback">0</span>
                                </li>
                                <li class="filter-item" onclick="filterMessages('complaint', this)">
                                    <i class="fas fa-exclamation-circle"></i>
                                    <span>Complaints</span>
                                    <span class="filter-count" id="count-complaint">0</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                    
                    <!-- Main Messages Area -->
                    <div class="messages-main">
                        <div class="main-header">
                            <div class="search-box">
                                <i class="fas fa-search"></i>
                                <input type="text" placeholder="Search messages..." id="searchInput" oninput="searchMessages()">
                            </div>
                            <div class="header-actions">
                                <button class="action-btn" title="Refresh" onclick="refreshMessages()">
                                    <i class="fas fa-sync-alt"></i>
                                </button>
                                <button class="action-btn" title="Settings">
                                    <i class="fas fa-cog"></i>
                                </button>
                            </div>
                        </div>
                        
                        <div class="messages-list" id="messagesList">
                            <div class="empty-state">
                                <i class="fas fa-inbox"></i>
                                <h3>No messages yet</h3>
                                <p>New customer messages will appear here</p>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
        let allMessages = [];
        let currentFilter = 'all';

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            loadConversations();
        });

        async function loadConversations() {
            try {
                const response = await fetch('/api/admin/messages/conversations');
                const data = await response.json();
                
                if (data.success) {
                    conversations = data.conversations || [];
                    updateStats();
                    renderConversations(conversations);
                }
            } catch (error) {
                console.error('Error loading conversations:', error);
                // Show empty state
                renderConversations([]);
            }
        }

        function updateStats() {
            document.getElementById('totalMessages').textContent = conversations.length;
            document.getElementById('unreadMessages').textContent = conversations.filter(c => c.unread_count > 0).length;
            document.getElementById('resolvedMessages').textContent = conversations.filter(c => c.status === 'resolved').length;
            document.getElementById('importantMessages').textContent = conversations.filter(c => c.status === 'open').length;

            // Update filter counts
            document.getElementById('count-all').textContent = conversations.length;
            document.getElementById('count-unread').textContent = conversations.filter(c => c.unread_count > 0).length;
            document.getElementById('count-important').textContent = conversations.filter(c => c.status === 'open').length;
            document.getElementById('count-resolved').textContent = conversations.filter(c => c.status === 'resolved').length;
        }

        function renderConversations(convs) {
            const container = document.getElementById('messagesList');
            
            if (!convs || convs.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-inbox"></i>
                        <h3>No conversations found</h3>
                        <p>${currentFilter !== 'all' ? 'Try a different filter' : 'New customer conversations will appear here'}</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = convs.map(conv => `
                <div class="message-card ${conv.unread_count > 0 ? 'unread' : ''}" onclick="openConversation('${conv.id}')">
                    <div class="message-avatar">
                        ${conv.user_avatar ? `<img src="${conv.user_avatar}" alt="Avatar">` : conv.user_name?.charAt(0).toUpperCase() || 'U'}
                    </div>
                    <div class="message-content">
                        <div class="message-top">
                            <span class="message-sender">
                                ${conv.user_name || 'Unknown User'}
                                ${conv.user_online ? '<span class="online-badge"></span>' : ''}
                            </span>
                            <span class="message-time">${formatTime(conv.last_message_at)}</span>
                        </div>
                        <div class="message-subject">${conv.last_message ? 'Last message' : 'No messages yet'}</div>
                        <div class="message-preview">${conv.last_message || 'Start a conversation'}</div>
                    </div>
                    <div class="message-actions">
                        ${conv.unread_count > 0 ? `<span class="unread-badge" style="margin-right: 8px;">${conv.unread_count}</span>` : ''}
                        <button class="msg-action-btn" title="Close conversation" onclick="event.stopPropagation(); closeConversation('${conv.id}')">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function filterMessages(filter, element) {
            currentFilter = filter;
            
            // Update active state
            document.querySelectorAll('.filter-item').forEach(item => item.classList.remove('active'));
            element.classList.add('active');
            
            // Filter conversations
            let filtered = conversations;
            
            if (filter === 'unread') {
                filtered = conversations.filter(c => c.unread_count > 0);
            } else if (filter === 'important') {
                filtered = conversations.filter(c => c.status === 'open');
            } else if (filter === 'resolved') {
                filtered = conversations.filter(c => c.status === 'resolved');
            }
            
            renderConversations(filtered);
        }

        function searchMessages() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            
            if (!query) {
                filterMessages(currentFilter, document.querySelector('.filter-item.active'));
                return;
            }
            
            const filtered = conversations.filter(c => 
                c.user_name?.toLowerCase().includes(query) ||
                c.last_message?.toLowerCase().includes(query)
            );
            
            renderConversations(filtered);
        }

        function refreshMessages() {
            loadConversations();
        }

        function openConversation(id) {
            window.location.href = `/admin/messages/chat/${id}`;
        }

        function openComposeModal() {
            window.location.href = '/admin/messages/compose';
        }

        async function toggleImportant(id) {
            // Not applicable for conversations
        }

        async function resolveMessage(id) {
            try {
                const response = await fetch('/api/admin/messages/conversations/' + id + '/close', {
                    method: 'POST'
                });
                const data = await response.json();
                
                if (data.success) {
                    loadConversations();
                }
            } catch (error) {
                console.error('Error resolving conversation:', error);
            }
        }

        async function deleteMessage(id) {
            // For now, just close the conversation
            resolveMessage(id);
        }

        async function closeConversation(id) {
            if (!confirm('Are you sure you want to close this conversation?')) return;
            
            try {
                const response = await fetch('/api/admin/messages/conversations/' + id + '/close', {
                    method: 'POST'
                });
                const data = await response.json();
                
                if (data.success) {
                    loadConversations();
                }
            } catch (error) {
                console.error('Error closing conversation:', error);
            }
        }

        function formatTime(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            const now = new Date();
            const diff = now - date;
            
            if (diff < 60000) return 'Just now';
            if (diff < 3600000) return Math.floor(diff / 60000) + 'm ago';
            if (diff < 86400000) return Math.floor(diff / 3600000) + 'h ago';
            if (diff < 604800000) return Math.floor(diff / 86400000) + 'd ago';
            
            return date.toLocaleDateString();
        }
    </script>
</body>
</html>
