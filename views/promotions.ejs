<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Promotions & Discounts - OMUNJU SHOPPERS</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/admin-enhanced.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Promotions Page Specific Styles */
        .promotions-hero {
            background: linear-gradient(135deg, #f39c12, #e67e22);
            color: white;
            padding: 4rem 0;
            text-align: center;
            margin-bottom: 3rem;
        }

        .promotions-hero h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .promotions-hero p {
            font-size: 1.3rem;
            opacity: 0.9;
        }

        .promotions-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Coupon Code Section */
        .coupon-section {
            background: white;
            padding: 3rem;
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 3rem;
        }

        .coupon-header {
            margin-bottom: 2rem;
            text-align: center;
        }

        .coupon-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .coupon-card {
            background: var(--bg-color);
            padding: 2rem;
            border-radius: 8px;
            text-align: center;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
        }

        .coupon-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            border-color: var(--secondary-color);
        }

        .coupon-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: var(--accent-color);
            color: white;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
        }

        .coupon-icon {
            font-size: 3rem;
            color: var(--secondary-color);
            margin-bottom: 1rem;
        }

        .coupon-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }

        .coupon-code {
            background: white;
            padding: 1rem;
            border-radius: 4px;
            font-family: 'Courier New', monospace;
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--primary-color);
            border: 2px dashed var(--secondary-color);
            margin: 1rem 0;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .coupon-code:hover {
            background: var(--secondary-color);
            color: white;
            border-color: var(--primary-color);
        }

        .coupon-description {
            color: #666;
            margin-bottom: 1rem;
            line-height: 1.5;
        }

        .coupon-validity {
            font-size: 0.9rem;
            color: #999;
            margin-bottom: 1rem;
        }

        .coupon-actions {
            display: flex;
            gap: 1rem;
            justify-content: center;
        }

        .btn-coupon {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-coupon-primary {
            background: var(--secondary-color);
            color: white;
        }

        .btn-coupon-primary:hover {
            background: #2980b9;
        }

        .btn-coupon-secondary {
            background: transparent;
            color: var(--text-color);
            border: 1px solid #ddd;
        }

        .btn-coupon-secondary:hover {
            background: #f8f9fa;
            border-color: var(--text-color);
        }

        /* Special Offers Section */
        .offers-section {
            margin-bottom: 3rem;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--bg-color);
        }

        .section-title {
            font-size: 2rem;
            color: var(--text-color);
            font-weight: 700;
        }

        .offers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 2rem;
        }

        .offer-card {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: all 0.3s ease;
            position: relative;
            border: 2px solid transparent;
        }

        .offer-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
            border-color: var(--secondary-color);
        }

        .offer-image {
            width: 100%;
            height: 200px;
            background: var(--bg-color);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .offer-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .offer-card:hover .offer-image img {
            transform: scale(1.05);
        }

        .offer-badge {
            position: absolute;
            top: 1rem;
            left: 1rem;
            background: var(--accent-color);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: bold;
            text-transform: uppercase;
            z-index: 2;
        }

        .offer-info {
            padding: 1.5rem;
        }

        .offer-category {
            color: var(--secondary-color);
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .offer-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
            line-height: 1.4;
        }

        .offer-description {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
            line-height: 1.5;
        }

        .offer-details {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .offer-price {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-color);
        }

        .offer-original-price {
            font-size: 1.1rem;
            color: #999;
            text-decoration: line-through;
        }

        .offer-discount {
            background: var(--accent-color);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            font-size: 1rem;
            font-weight: bold;
        }

        .offer-actions {
            display: flex;
            gap: 1rem;
        }

        .btn-offer {
            flex: 1;
            padding: 0.75rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }

        .btn-offer-primary {
            background: var(--secondary-color);
            color: white;
        }

        .btn-offer-primary:hover {
            background: #2980b9;
        }

        .btn-offer-secondary {
            background: transparent;
            color: var(--text-color);
            border: 1px solid #ddd;
        }

        .btn-offer-secondary:hover {
            background: #f8f9fa;
            border-color: var(--text-color);
        }

        /* Promo Code Input Section */
        .promo-input-section {
            background: white;
            padding: 3rem;
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 3rem;
        }

        .promo-form {
            display: flex;
            gap: 1rem;
            max-width: 600px;
            margin: 0 auto;
        }

        .promo-input {
            flex: 1;
            padding: 1rem;
            border: 2px solid #ddd;
            border-radius: 4px;
            font-size: 1.1rem;
            transition: border-color 0.3s ease;
        }

        .promo-input:focus {
            outline: none;
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
        }

        .btn-apply {
            background: var(--secondary-color);
            color: white;
            padding: 1rem 2rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-apply:hover {
            background: #2980b9;
        }

        .promo-result {
            text-align: center;
            margin-top: 1rem;
            min-height: 1.5rem;
        }

        .promo-success {
            color: #27ae60;
            font-weight: bold;
        }

        .promo-error {
            color: #e74c3c;
            font-weight: bold;
        }

        /* Loading and Empty States */
        .loading-promotions {
            text-align: center;
            padding: 3rem;
            color: var(--text-color);
        }

        .no-promotions {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: 8px;
            box-shadow: var(--shadow);
        }

        .no-promotions i {
            font-size: 4rem;
            color: #ddd;
            margin-bottom: 1rem;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .promotions-hero h1 {
                font-size: 2.5rem;
            }

            .coupon-grid {
                grid-template-columns: 1fr;
            }

            .offers-grid {
                grid-template-columns: 1fr;
            }

            .promo-form {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <!-- Enhanced Navigation -->
    <%- include('partials/navigation-enhanced', { currentPage: 'promotions', user: user }) %>

    <!-- Promotions Hero Section -->
    <section class="promotions-hero">
        <div class="promotions-container">
            <h1>Special Promotions & Discounts</h1>
            <p>Unlock amazing savings with our exclusive promo codes and special offers!</p>
        </div>
    </section>

    <!-- Main Content -->
    <main class="main-content">
        <div class="promotions-container">
            <!-- Promo Code Input Section -->
            <section class="promo-input-section">
                <div class="coupon-header">
                    <h2>Have a Promo Code?</h2>
                    <p>Enter your code below to apply discounts to your order</p>
                </div>
                
                <div class="promo-form">
                    <input type="text" id="promoCodeInput" class="promo-input" placeholder="Enter your promo code here...">
                    <button class="btn-apply" onclick="applyPromoCode()">Apply Code</button>
                </div>
                
                <div id="promoResult" class="promo-result"></div>
            </section>

            <!-- Available Coupons Section -->
            <section class="coupon-section">
                <div class="coupon-header">
                    <h2>Available Promo Codes</h2>
                    <p>Use these codes at checkout to save on your purchases</p>
                </div>
                
                <div id="couponsGrid" class="coupon-grid">
                    <!-- Coupons will be loaded here -->
                </div>
            </section>

            <!-- Special Offers Section -->
            <section class="offers-section">
                <div class="section-header">
                    <h2 class="section-title">Special Offers</h2>
                    <a href="/categories" class="view-all-btn">View All Products</a>
                </div>
                
                <div id="offersGrid" class="offers-grid">
                    <!-- Offers will be loaded here -->
                </div>
            </section>
        </div>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Scripts -->
    <script>
        // Promotions Page JavaScript
        let coupons = [];
        let offers = [];

        // Initialize page
        document.addEventListener('DOMContentLoaded', () => {
            loadCoupons();
            loadOffers();
            setupEventListeners();
        });

        // Load coupons from database
        async function loadCoupons() {
            try {
                const response = await fetch('/api/promotions/coupons');
                const data = await response.json();

                if (data.success) {
                    coupons = data.coupons;
                    renderCoupons();
                } else {
                    showNoCoupons('Failed to load coupons. Please try again.');
                }
            } catch (error) {
                console.error('Error loading coupons:', error);
                showNoCoupons('Error loading coupons. Please check your connection.');
            }
        }

        // Load offers from database
        async function loadOffers() {
            try {
                const response = await fetch('/api/promotions/offers');
                const data = await response.json();

                if (data.success) {
                    offers = data.offers;
                    renderOffers();
                } else {
                    showNoOffers('Failed to load offers. Please try again.');
                }
            } catch (error) {
                console.error('Error loading offers:', error);
                showNoOffers('Error loading offers. Please check your connection.');
            }
        }

        // Setup event listeners
        function setupEventListeners() {
            // Promo code input
            const promoInput = document.getElementById('promoCodeInput');
            promoInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    applyPromoCode();
                }
            });

            // Search functionality
            const searchInput = document.getElementById('globalSearch');
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    const searchTerm = e.target.value.toLowerCase();
                    if (searchTerm.length > 2) {
                        const filteredCoupons = coupons.filter(coupon => 
                            coupon.code.toLowerCase().includes(searchTerm) ||
                            coupon.description.toLowerCase().includes(searchTerm)
                        );
                        const filteredOffers = offers.filter(offer => 
                            offer.name.toLowerCase().includes(searchTerm) ||
                            offer.description.toLowerCase().includes(searchTerm) ||
                            offer.category.toLowerCase().includes(searchTerm)
                        );
                        renderCoupons(filteredCoupons);
                        renderOffers(filteredOffers);
                    } else if (searchTerm.length === 0) {
                        renderCoupons(coupons);
                        renderOffers(offers);
                    }
                });
            }
        }

        // Render coupons
        function renderCoupons(couponsToShow = coupons) {
            const couponsGrid = document.getElementById('couponsGrid');

            if (couponsToShow.length === 0) {
                showNoCoupons('No promo codes available at the moment. Check back soon!');
                return;
            }

            couponsGrid.innerHTML = couponsToShow.map(coupon => `
                <div class="coupon-card">
                    <div class="coupon-badge">Active</div>
                    <div class="coupon-icon">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                    <h3 class="coupon-title">${coupon.name}</h3>
                    <div class="coupon-code" onclick="copyCouponCode('${coupon.code}')">
                        ${coupon.code}
                    </div>
                    <p class="coupon-description">${coupon.description}</p>
                    <div class="coupon-validity">
                        Valid until: ${formatDate(coupon.expiry_date)}
                    </div>
                    <div class="coupon-actions">
                        <button class="btn-coupon btn-coupon-primary" onclick="copyCouponCode('${coupon.code}')">
                            <i class="fas fa-copy"></i> Copy Code
                        </button>
                        <button class="btn-coupon btn-coupon-secondary" onclick="applyPromoCode('${coupon.code}')">
                            <i class="fas fa-shopping-cart"></i> Apply Now
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // Render offers
        function renderOffers(offersToShow = offers) {
            const offersGrid = document.getElementById('offersGrid');

            if (offersToShow.length === 0) {
                showNoOffers('No special offers available at the moment. Check back soon!');
                return;
            }

            offersGrid.innerHTML = offersToShow.map(offer => `
                <div class="offer-card">
                    <div class="offer-badge">${offer.type}</div>
                    <div class="offer-image">
                        <img src="${offer.image_url || '/images/default-product.jpg'}" alt="${offer.name}">
                    </div>
                    <div class="offer-info">
                        <div class="offer-category">${offer.category || 'General'}</div>
                        <h3 class="offer-title">${offer.name}</h3>
                        <p class="offer-description">${offer.description}</p>
                        
                        <div class="offer-details">
                            <span class="offer-price">KSh ${formatPrice(offer.price)}</span>
                            ${offer.original_price ? `<span class="offer-original-price">KSh ${formatPrice(offer.original_price)}</span>` : ''}
                            ${offer.discount ? `<span class="offer-discount">-${offer.discount}% OFF</span>` : ''}
                        </div>

                        <div class="offer-actions">
                            <button class="btn-offer btn-offer-primary" onclick="addToCart(${offer.id})">
                                <i class="fas fa-shopping-cart"></i> Add to Cart
                            </button>
                            <button class="btn-offer btn-offer-secondary" onclick="viewProduct(${offer.id})">
                                <i class="fas fa-eye"></i> View Details
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Apply promo code
        async function applyPromoCode(code = null) {
            const promoInput = document.getElementById('promoCodeInput');
            const promoResult = document.getElementById('promoResult');
            
            const promoCode = code || promoInput.value.trim();
            
            if (!promoCode) {
                promoResult.innerHTML = '<span class="promo-error">Please enter a promo code</span>';
                return;
            }

            try {
                const response = await fetch('/api/promotions/validate', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        code: promoCode
                    })
                });

                const data = await response.json();
                
                if (data.success) {
                    promoResult.innerHTML = `
                        <span class="promo-success">
                            <i class="fas fa-check-circle"></i> 
                            Promo code applied! You saved KSh ${formatPrice(data.discount_amount)}
                        </span>
                    `;
                    promoInput.value = '';
                    
                    // Store the applied promo code for checkout
                    localStorage.setItem('appliedPromoCode', promoCode);
                    localStorage.setItem('promoDiscount', data.discount_amount);
                } else {
                    promoResult.innerHTML = `
                        <span class="promo-error">
                            <i class="fas fa-times-circle"></i> 
                            ${data.message || 'Invalid promo code'}
                        </span>
                    `;
                }
            } catch (error) {
                console.error('Error applying promo code:', error);
                promoResult.innerHTML = `
                    <span class="promo-error">
                        <i class="fas fa-times-circle"></i> 
                        Error applying promo code. Please try again.
                    </span>
                `;
            }
        }

        // Copy coupon code to clipboard
        function copyCouponCode(code) {
            navigator.clipboard.writeText(code).then(() => {
                // Show success message
                const result = document.createElement('div');
                result.className = 'promo-success';
                result.innerHTML = '<i class="fas fa-check-circle"></i> Code copied to clipboard!';
                document.getElementById('promoResult').appendChild(result);
                
                // Remove message after 3 seconds
                setTimeout(() => {
                    result.remove();
                }, 3000);
            }).catch(err => {
                console.error('Failed to copy: ', err);
            });
        }

        // Helper functions
        function formatPrice(price) {
            return new Intl.NumberFormat('en-KE', {
                style: 'currency',
                currency: 'KES',
                minimumFractionDigits: 0
            }).format(price);
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('en-KE', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
        }

        // Product actions
        async function addToCart(productId) {
            if (!isLoggedIn) {
                alert('Please login to add products to cart.');
                window.location.href = '/login';
                return;
            }

            try {
                const response = await fetch('/api/cart/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        product_id: productId,
                        quantity: 1
                    })
                });

                const data = await response.json();
                
                if (data.success) {
                    alert('Product added to cart!');
                    updateCartCount();
                } else {
                    alert('Failed to add product to cart.');
                }
            } catch (error) {
                console.error('Error adding to cart:', error);
                alert('Error adding product to cart.');
            }
        }

        function viewProduct(productId) {
            window.location.href = `/product/${productId}`;
        }

        function showNoCoupons(message) {
            const couponsGrid = document.getElementById('couponsGrid');
            couponsGrid.innerHTML = `
                <div class="no-promotions">
                    <i class="fas fa-ticket-alt"></i>
                    <h3>No Promo Codes Available</h3>
                    <p>${message}</p>
                    <a href="/categories" class="view-all-btn">Browse Products</a>
                </div>
            `;
        }

        function showNoOffers(message) {
            const offersGrid = document.getElementById('offersGrid');
            offersGrid.innerHTML = `
                <div class="no-promotions">
                    <i class="fas fa-gift"></i>
                    <h3>No Special Offers Available</h3>
                    <p>${message}</p>
                    <a href="/categories" class="view-all-btn">Browse Products</a>
                </div>
            `;
        }
    </script>
</body>
</html>