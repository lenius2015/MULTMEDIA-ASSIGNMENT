<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notifications - OMUNJU SHOPPERS</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/admin-enhanced.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Notifications Page Specific Styles */
        .notifications-hero {
            background: linear-gradient(135deg, #9b59b6, #8e44ad);
            color: white;
            padding: 4rem 0;
            text-align: center;
            margin-bottom: 3rem;
        }

        .notifications-hero h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .notifications-hero p {
            font-size: 1.3rem;
            opacity: 0.9;
        }

        .notifications-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Notifications Header */
        .notifications-header {
            background: white;
            padding: 2rem;
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .notifications-stats {
            display: flex;
            gap: 2rem;
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            color: var(--primary-color);
        }

        .stat-label {
            font-size: 0.9rem;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .notifications-actions {
            display: flex;
            gap: 1rem;
        }

        .btn-notification {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-notification-primary {
            background: var(--secondary-color);
            color: white;
        }

        .btn-notification-primary:hover {
            background: #2980b9;
        }

        .btn-notification-secondary {
            background: transparent;
            color: var(--text-color);
            border: 1px solid #ddd;
        }

        .btn-notification-secondary:hover {
            background: #f8f9fa;
            border-color: var(--text-color);
        }

        /* Notifications Filter */
        .notifications-filter {
            background: white;
            padding: 1.5rem;
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 2rem;
        }

        .filter-controls {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter-group {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            background: var(--bg-color);
            padding: 0.5rem 1rem;
            border-radius: 20px;
        }

        .filter-group input[type="checkbox"] {
            margin-right: 0.5rem;
        }

        /* Notifications List */
        .notifications-list {
            background: white;
            border-radius: 8px;
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .notification-item {
            padding: 1.5rem;
            border-bottom: 1px solid #eee;
            transition: all 0.3s ease;
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }

        .notification-item:last-child {
            border-bottom: none;
        }

        .notification-item:hover {
            background: var(--bg-color);
        }

        .notification-item.unread {
            background: #f8f9fa;
            border-left: 4px solid var(--secondary-color);
        }

        .notification-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 1.2rem;
            color: white;
        }

        .notification-icon.info {
            background: var(--secondary-color);
        }

        .notification-icon.success {
            background: #27ae60;
        }

        .notification-icon.warning {
            background: #f39c12;
        }

        .notification-icon.error {
            background: #e74c3c;
        }

        .notification-content {
            flex: 1;
        }

        .notification-title {
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
            font-size: 1.1rem;
        }

        .notification-message {
            color: #666;
            line-height: 1.5;
            margin-bottom: 1rem;
        }

        .notification-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.8rem;
            color: #999;
        }

        .notification-actions {
            display: flex;
            gap: 0.5rem;
        }

        .btn-action {
            padding: 0.25rem 0.75rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: white;
            cursor: pointer;
            font-size: 0.8rem;
            transition: all 0.3s ease;
        }

        .btn-action:hover {
            background: #f8f9fa;
            border-color: var(--text-color);
        }

        .btn-primary-action {
            background: var(--secondary-color);
            color: white;
            border-color: var(--secondary-color);
        }

        .btn-primary-action:hover {
            background: #2980b9;
            border-color: #2980b9;
        }

        /* Empty State */
        .empty-notifications {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: 8px;
            box-shadow: var(--shadow);
        }

        .empty-notifications i {
            font-size: 4rem;
            color: #ddd;
            margin-bottom: 1rem;
        }

        .empty-notifications h3 {
            color: var(--text-color);
            margin-bottom: 1rem;
        }

        /* Loading State */
        .loading-notifications {
            text-align: center;
            padding: 3rem;
            color: var(--text-color);
        }

        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid var(--secondary-color);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .notifications-hero h1 {
                font-size: 2.5rem;
            }

            .notifications-stats {
                flex-direction: column;
                gap: 1rem;
            }

            .filter-controls {
                flex-direction: column;
                align-items: flex-start;
            }

            .notification-item {
                flex-direction: column;
                align-items: flex-start;
            }

            .notification-actions {
                align-self: flex-end;
            }
        }
    </style>
</head>
<body>
    <!-- Enhanced Navigation -->
    <%- include('partials/navigation-enhanced', { currentPage: 'notifications', user: user }) %>

    <!-- Notifications Hero Section -->
    <section class="notifications-hero">
        <div class="notifications-container">
            <h1>Notifications</h1>
            <p>Stay updated with the latest news, offers, and important updates</p>
        </div>
    </section>

    <!-- Main Content -->
    <main class="main-content">
        <div class="notifications-container">
            <!-- Notifications Header -->
            <section class="notifications-header">
                <div class="notifications-stats">
                    <div class="stat-item">
                        <div class="stat-number" id="totalNotifications">0</div>
                        <div class="stat-label">Total</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number" id="unreadNotifications">0</div>
                        <div class="stat-label">Unread</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number" id="todayNotifications">0</div>
                        <div class="stat-label">Today</div>
                    </div>
                </div>
                
                <div class="notifications-actions">
                    <button class="btn-notification btn-notification-secondary" onclick="markAllAsRead()">
                        <i class="fas fa-check-double"></i> Mark All Read
                    </button>
                    <button class="btn-notification btn-notification-secondary" onclick="clearAllNotifications()">
                        <i class="fas fa-trash"></i> Clear All
                    </button>
                    <button class="btn-notification btn-notification-primary" onclick="refreshNotifications()">
                        <i class="fas fa-refresh"></i> Refresh
                    </button>
                </div>
            </section>

            <!-- Notifications Filter -->
            <section class="notifications-filter">
                <div class="filter-controls">
                    <div class="filter-group">
                        <input type="checkbox" id="filterUnread" onchange="filterNotifications()">
                        <label for="filterUnread">Unread Only</label>
                    </div>
                    <div class="filter-group">
                        <input type="checkbox" id="filterToday" onchange="filterNotifications()">
                        <label for="filterToday">Today Only</label>
                    </div>
                    <div class="filter-group">
                        <input type="checkbox" id="filterImportant" onchange="filterNotifications()">
                        <label for="filterImportant">Important</label>
                    </div>
                    <div class="filter-group">
                        <input type="checkbox" id="filterPromotions" onchange="filterNotifications()">
                        <label for="filterPromotions">Promotions</label>
                    </div>
                    <div class="filter-group">
                        <input type="checkbox" id="filterOrders" onchange="filterNotifications()">
                        <label for="filterOrders">Orders</label>
                    </div>
                </div>
            </section>

            <!-- Notifications List -->
            <section class="notifications-list" id="notificationsList">
                <!-- Notifications will be loaded here -->
                <div class="loading-notifications">
                    <div class="spinner"></div>
                    <p>Loading notifications...</p>
                </div>
            </section>
        </div>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Scripts -->
    <script>
        // Notifications Page JavaScript
        let notifications = [];
        let filteredNotifications = [];
        let notificationInterval;

        // Initialize page
        document.addEventListener('DOMContentLoaded', () => {
            loadNotifications();
            setupEventListeners();
            startRealTimeUpdates();
        });

        // Setup event listeners
        function setupEventListeners() {
            // Search functionality
            const searchInput = document.getElementById('globalSearch');
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    const searchTerm = e.target.value.toLowerCase();
                    if (searchTerm.length > 2) {
                        filteredNotifications = notifications.filter(notification => 
                            notification.title.toLowerCase().includes(searchTerm) ||
                            notification.message.toLowerCase().includes(searchTerm)
                        );
                        renderNotifications(filteredNotifications);
                    } else if (searchTerm.length === 0) {
                        applyFilters();
                    }
                });
            }
        }

        // Load notifications from database
        async function loadNotifications() {
            try {
                const response = await fetch('/api/notifications');
                const data = await response.json();

                if (data.success) {
                    notifications = data.notifications;
                    updateStats();
                    applyFilters();
                } else {
                    showEmptyState('Failed to load notifications. Please try again.');
                }
            } catch (error) {
                console.error('Error loading notifications:', error);
                showEmptyState('Error loading notifications. Please check your connection.');
            }
        }

        // Apply filters
        function applyFilters() {
            let filtered = [...notifications];

            // Unread filter
            if (document.getElementById('filterUnread').checked) {
                filtered = filtered.filter(n => !n.read_at);
            }

            // Today filter
            if (document.getElementById('filterToday').checked) {
                const today = new Date().toDateString();
                filtered = filtered.filter(n => new Date(n.created_at).toDateString() === today);
            }

            // Type filters
            const typeFilters = [
                { id: 'filterImportant', type: 'important' },
                { id: 'filterPromotions', type: 'promotion' },
                { id: 'filterOrders', type: 'order' }
            ];

            const activeFilters = typeFilters.filter(f => document.getElementById(f.id).checked);
            
            if (activeFilters.length > 0) {
                filtered = filtered.filter(n => 
                    activeFilters.some(f => n.type === f.type)
                );
            }

            filteredNotifications = filtered;
            renderNotifications(filteredNotifications);
        }

        // Render notifications
        function renderNotifications(notificationsToShow) {
            const notificationsList = document.getElementById('notificationsList');

            if (notificationsToShow.length === 0) {
                showEmptyState('No notifications found. Check back later for updates!');
                return;
            }

            notificationsList.innerHTML = notificationsToShow.map(notification => `
                <div class="notification-item ${!notification.read_at ? 'unread' : ''}">
                    <div class="notification-icon ${getNotificationIconClass(notification.type)}">
                        <i class="${getNotificationIcon(notification.type)}"></i>
                    </div>
                    <div class="notification-content">
                        <div class="notification-title">${notification.title}</div>
                        <div class="notification-message">${notification.message}</div>
                        <div class="notification-meta">
                            <span>${formatDate(notification.created_at)}</span>
                            <div class="notification-actions">
                                ${notification.type === 'order' ? `
                                    <button class="btn-action btn-primary-action" onclick="viewOrderDetails('${notification.related_id}')">
                                        View Order
                                    </button>
                                ` : ''}
                                ${notification.type === 'promotion' ? `
                                    <button class="btn-action" onclick="viewPromotion('${notification.related_id}')">
                                        View Details
                                    </button>
                                ` : ''}
                                ${!notification.read_at ? `
                                    <button class="btn-action" onclick="markAsRead('${notification.id}')">
                                        Mark Read
                                    </button>
                                ` : ''}
                                <button class="btn-action" onclick="deleteNotification('${notification.id}')">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Get notification icon class
        function getNotificationIconClass(type) {
            switch (type) {
                case 'important': return 'error';
                case 'promotion': return 'warning';
                case 'order': return 'success';
                default: return 'info';
            }
        }

        // Get notification icon
        function getNotificationIcon(type) {
            switch (type) {
                case 'important': return 'fas fa-exclamation-circle';
                case 'promotion': return 'fas fa-gift';
                case 'order': return 'fas fa-shopping-bag';
                default: return 'fas fa-bell';
            }
        }

        // Update statistics
        function updateStats() {
            const total = notifications.length;
            const unread = notifications.filter(n => !n.read_at).length;
            const today = notifications.filter(n => 
                new Date(n.created_at).toDateString() === new Date().toDateString()
            ).length;

            document.getElementById('totalNotifications').textContent = total;
            document.getElementById('unreadNotifications').textContent = unread;
            document.getElementById('todayNotifications').textContent = today;
        }

        // Mark notification as read
        async function markAsRead(notificationId) {
            try {
                const response = await fetch(`/api/notifications/${notificationId}/read`, {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                const data = await response.json();
                
                if (data.success) {
                    // Update local notification
                    const notification = notifications.find(n => n.id === notificationId);
                    if (notification) {
                        notification.read_at = new Date().toISOString();
                    }
                    updateStats();
                    applyFilters();
                }
            } catch (error) {
                console.error('Error marking notification as read:', error);
            }
        }

        // Mark all notifications as read
        async function markAllAsRead() {
            try {
                const response = await fetch('/api/notifications/mark-all-read', {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                const data = await response.json();
                
                if (data.success) {
                    // Update all notifications locally
                    notifications.forEach(n => {
                        if (!n.read_at) {
                            n.read_at = new Date().toISOString();
                        }
                    });
                    updateStats();
                    applyFilters();
                }
            } catch (error) {
                console.error('Error marking all notifications as read:', error);
            }
        }

        // Clear all notifications
        async function clearAllNotifications() {
            if (!confirm('Are you sure you want to delete all notifications?')) {
                return;
            }

            try {
                const response = await fetch('/api/notifications/clear-all', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                const data = await response.json();
                
                if (data.success) {
                    notifications = [];
                    updateStats();
                    applyFilters();
                }
            } catch (error) {
                console.error('Error clearing notifications:', error);
            }
        }

        // Delete single notification
        async function deleteNotification(notificationId) {
            try {
                const response = await fetch(`/api/notifications/${notificationId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });

                const data = await response.json();
                
                if (data.success) {
                    notifications = notifications.filter(n => n.id !== notificationId);
                    updateStats();
                    applyFilters();
                }
            } catch (error) {
                console.error('Error deleting notification:', error);
            }
        }

        // View order details
        function viewOrderDetails(orderId) {
            if (orderId) {
                window.location.href = `/order/${orderId}`;
            }
        }

        // View promotion details
        function viewPromotion(promotionId) {
            if (promotionId) {
                window.location.href = `/promotions`;
            }
        }

        // Refresh notifications
        function refreshNotifications() {
            loadNotifications();
        }

        // Start real-time updates
        function startRealTimeUpdates() {
            // Check for new notifications every 30 seconds
            notificationInterval = setInterval(() => {
                loadNotifications();
            }, 30000);
        }

        // Stop real-time updates
        function stopRealTimeUpdates() {
            if (notificationInterval) {
                clearInterval(notificationInterval);
            }
        }

        // Filter notifications (called when filter checkboxes change)
        function filterNotifications() {
            applyFilters();
        }

        // Show empty state
        function showEmptyState(message) {
            const notificationsList = document.getElementById('notificationsList');
            notificationsList.innerHTML = `
                <div class="empty-notifications">
                    <i class="fas fa-bell-slash"></i>
                    <h3>No Notifications</h3>
                    <p>${message}</p>
                    <button class="btn-notification btn-notification-primary" onclick="refreshNotifications()">
                        <i class="fas fa-refresh"></i> Check for Updates
                    </button>
                </div>
            `;
        }

        // Helper functions
        function formatDate(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const diffMs = now - date;
            const diffMins = Math.floor(diffMs / 60000);
            const diffHours = Math.floor(diffMs / 3600000);
            const diffDays = Math.floor(diffMs / 86400000);

            if (diffMins < 1) return 'Just now';
            if (diffMins < 60) return `${diffMins} minutes ago`;
            if (diffHours < 24) return `${diffHours} hours ago`;
            if (diffDays < 7) return `${diffDays} days ago`;
            
            return date.toLocaleDateString('en-KE', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        // Cleanup on page unload
        window.addEventListener('beforeunload', stopRealTimeUpdates);
    </script>
</body>
</html>