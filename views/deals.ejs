<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deals & Offers - OMUNJU SHOPPERS</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/admin-enhanced.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Deals Page Specific Styles */
        .deals-hero {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: white;
            padding: 4rem 0;
            text-align: center;
            margin-bottom: 3rem;
        }

        .deals-hero h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .deals-hero p {
            font-size: 1.3rem;
            opacity: 0.9;
        }

        .deals-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Countdown Timer Styles */
        .countdown-section {
            background: white;
            padding: 3rem;
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 3rem;
            text-align: center;
        }

        .countdown-header {
            margin-bottom: 2rem;
        }

        .countdown-timer {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .countdown-box {
            background: var(--primary-color);
            color: white;
            padding: 2rem;
            border-radius: 8px;
            min-width: 120px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .countdown-number {
            font-size: 3rem;
            font-weight: bold;
            display: block;
        }

        .countdown-label {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.8;
        }

        .countdown-expired {
            color: var(--accent-color);
            font-size: 1.5rem;
            font-weight: bold;
        }

        /* Featured Deals Section */
        .featured-deals {
            margin-bottom: 3rem;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid var(--bg-color);
        }

        .section-title {
            font-size: 2rem;
            color: var(--text-color);
            font-weight: 700;
        }

        .view-all-btn {
            background: transparent;
            color: var(--secondary-color);
            border: 1px solid var(--secondary-color);
            padding: 0.5rem 1.5rem;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .view-all-btn:hover {
            background: var(--secondary-color);
            color: white;
        }

        /* Deal Product Cards */
        .deals-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 2rem;
        }

        .deal-card {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: all 0.3s ease;
            position: relative;
            border: 2px solid transparent;
        }

        .deal-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
            border-color: var(--secondary-color);
        }

        .deal-badge {
            position: absolute;
            top: 1rem;
            left: 1rem;
            background: var(--accent-color);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: bold;
            text-transform: uppercase;
            z-index: 2;
        }

        .deal-countdown {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: rgba(0,0,0,0.8);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
            z-index: 2;
        }

        .deal-image {
            width: 100%;
            height: 200px;
            background: var(--bg-color);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .deal-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .deal-card:hover .deal-image img {
            transform: scale(1.05);
        }

        .deal-info {
            padding: 1.5rem;
        }

        .deal-category {
            color: var(--secondary-color);
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.5rem;
        }

        .deal-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
            line-height: 1.4;
        }

        .deal-description {
            color: #666;
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
            line-height: 1.5;
        }

        .deal-prices {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .deal-price-current {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary-color);
        }

        .deal-price-original {
            font-size: 1.2rem;
            color: #999;
            text-decoration: line-through;
        }

        .deal-discount {
            background: var(--accent-color);
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 4px;
            font-size: 1rem;
            font-weight: bold;
        }

        .deal-progress {
            margin-bottom: 1.5rem;
        }

        .progress-bar {
            width: 100%;
            height: 8px;
            background: #eee;
            border-radius: 4px;
            overflow: hidden;
            margin-bottom: 0.5rem;
        }

        .progress-fill {
            height: 100%;
            background: var(--secondary-color);
            width: 0%;
            transition: width 0.3s ease;
        }

        .progress-text {
            font-size: 0.8rem;
            color: #666;
            display: flex;
            justify-content: space-between;
        }

        .deal-actions {
            display: flex;
            gap: 1rem;
        }

        .btn-deal {
            flex: 1;
            padding: 0.75rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }

        .btn-deal-primary {
            background: var(--secondary-color);
            color: white;
        }

        .btn-deal-primary:hover {
            background: #2980b9;
        }

        .btn-deal-secondary {
            background: transparent;
            color: var(--text-color);
            border: 1px solid #ddd;
        }

        .btn-deal-secondary:hover {
            background: #f8f9fa;
            border-color: var(--text-color);
        }

        /* Categories Section */
        .categories-section {
            background: white;
            padding: 3rem;
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 3rem;
        }

        .categories-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
        }

        .category-card {
            background: var(--bg-color);
            padding: 2rem;
            border-radius: 8px;
            text-align: center;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            border-color: var(--secondary-color);
        }

        .category-icon {
            font-size: 3rem;
            color: var(--secondary-color);
            margin-bottom: 1rem;
        }

        .category-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }

        .category-count {
            color: #666;
            font-size: 0.9rem;
        }

        /* Loading and Empty States */
        .loading-deals {
            text-align: center;
            padding: 3rem;
            color: var(--text-color);
        }

        .no-deals {
            text-align: center;
            padding: 4rem;
            background: white;
            border-radius: 8px;
            box-shadow: var(--shadow);
        }

        .no-deals i {
            font-size: 4rem;
            color: #ddd;
            margin-bottom: 1rem;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .deals-hero h1 {
                font-size: 2.5rem;
            }

            .countdown-timer {
                gap: 1rem;
            }

            .countdown-box {
                min-width: 80px;
                padding: 1rem;
            }

            .countdown-number {
                font-size: 2rem;
            }

            .deals-grid {
                grid-template-columns: 1fr;
            }

            .categories-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- Enhanced Navigation -->
    <%- include('partials/navigation-enhanced', { currentPage: 'deals', user: user }) %>

    <!-- Deals Hero Section -->
    <section class="deals-hero">
        <div class="deals-container">
            <h1>Flash Deals & Special Offers</h1>
            <p>Don't miss out on amazing discounts and limited-time offers!</p>
        </div>
    </section>

    <!-- Main Content -->
    <main class="main-content">
        <div class="deals-container">
            <!-- Countdown Timer Section -->
            <section class="countdown-section">
                <div class="countdown-header">
                    <h2>Time Limited Offers</h2>
                    <p>Shop now before these deals expire!</p>
                </div>
                <div id="mainCountdown" class="countdown-timer">
                    <!-- Countdown will be loaded here -->
                </div>
                <div id="countdownStatus" class="countdown-expired" style="display: none;">
                    Deals expired! Check back for new offers.
                </div>
            </section>

            <!-- Featured Deals Section -->
            <section class="featured-deals">
                <div class="section-header">
                    <h2 class="section-title">Featured Deals</h2>
                    <a href="/categories" class="view-all-btn">View All Categories</a>
                </div>
                
                <div id="dealsGrid" class="deals-grid">
                    <!-- Deals will be loaded here -->
                </div>
            </section>

            <!-- Categories Section -->
            <section class="categories-section">
                <div class="section-header">
                    <h2 class="section-title">Shop by Category</h2>
                    <a href="/categories" class="view-all-btn">View All Categories</a>
                </div>
                
                <div class="categories-grid">
                    <div class="category-card">
                        <div class="category-icon">
                            <i class="fas fa-laptop"></i>
                        </div>
                        <h3 class="category-title">Electronics</h3>
                        <p class="category-count">50+ products on sale</p>
                    </div>
                    
                    <div class="category-card">
                        <div class="category-icon">
                            <i class="fas fa-tshirt"></i>
                        </div>
                        <h3 class="category-title">Fashion</h3>
                        <p class="category-count">100+ products on sale</p>
                    </div>
                    
                    <div class="category-card">
                        <div class="category-icon">
                            <i class="fas fa-home"></i>
                        </div>
                        <h3 class="category-title">Home & Garden</h3>
                        <p class="category-count">75+ products on sale</p>
                    </div>
                    
                    <div class="category-card">
                        <div class="category-icon">
                            <i class="fas fa-dumbbell"></i>
                        </div>
                        <h3 class="category-title">Sports & Outdoors</h3>
                        <p class="category-count">40+ products on sale</p>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Scripts -->
    <script>
        // Deals Page JavaScript
        let deals = [];
        let countdownEvents = [];
        let countdownInterval;

        // Initialize page
        document.addEventListener('DOMContentLoaded', () => {
            loadDeals();
            loadCountdownEvents();
            setupEventListeners();
        });

        // Load deals from database
        async function loadDeals() {
            try {
                const response = await fetch('/api/deals');
                const data = await response.json();

                if (data.success) {
                    deals = data.deals;
                    renderDeals();
                } else {
                    showNoDeals('Failed to load deals. Please try again.');
                }
            } catch (error) {
                console.error('Error loading deals:', error);
                showNoDeals('Error loading deals. Please check your connection.');
            }
        }

        // Load countdown events
        async function loadCountdownEvents() {
            try {
                const response = await fetch('/api/countdowns/active');
                const data = await response.json();

                if (data.success && data.events.length > 0) {
                    countdownEvents = data.events;
                    startCountdown(countdownEvents[0]);
                } else {
                    document.getElementById('countdownStatus').style.display = 'block';
                    document.getElementById('mainCountdown').style.display = 'none';
                }
            } catch (error) {
                console.error('Error loading countdowns:', error);
            }
        }

        // Setup event listeners
        function setupEventListeners() {
            // Search functionality
            const searchInput = document.getElementById('globalSearch');
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    const searchTerm = e.target.value.toLowerCase();
                    if (searchTerm.length > 2) {
                        const filteredDeals = deals.filter(deal => 
                            deal.name.toLowerCase().includes(searchTerm) ||
                            deal.description.toLowerCase().includes(searchTerm) ||
                            deal.category.toLowerCase().includes(searchTerm)
                        );
                        renderDeals(filteredDeals);
                    } else if (searchTerm.length === 0) {
                        renderDeals(deals);
                    }
                });
            }
        }

        // Render deals
        function renderDeals(dealsToShow = deals) {
            const dealsGrid = document.getElementById('dealsGrid');

            if (dealsToShow.length === 0) {
                showNoDeals('No deals available at the moment. Check back soon!');
                return;
            }

            dealsGrid.innerHTML = dealsToShow.map(deal => `
                <div class="deal-card">
                    <div class="deal-badge">-${deal.discount}% OFF</div>
                    <div class="deal-countdown">
                        <i class="fas fa-clock"></i> Limited Time
                    </div>
                    <div class="deal-image">
                        <img src="${deal.image_url || '/images/default-product.jpg'}" alt="${deal.name}">
                    </div>
                    <div class="deal-info">
                        <div class="deal-category">${deal.category || 'General'}</div>
                        <h3 class="deal-title">${deal.name}</h3>
                        <p class="deal-description">${deal.description || 'Amazing deal available!'}</p>
                        
                        <div class="deal-prices">
                            <span class="deal-price-current">KSh ${formatPrice(deal.price)}</span>
                            <span class="deal-price-original">KSh ${formatPrice(deal.original_price)}</span>
                            <span class="deal-discount">Save KSh ${formatPrice(deal.original_price - deal.price)}</span>
                        </div>

                        <div class="deal-progress">
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: ${calculateProgress(deal)}%"></div>
                            </div>
                            <div class="progress-text">
                                <span>${deal.sold_quantity} sold</span>
                                <span>${deal.stock} available</span>
                            </div>
                        </div>

                        <div class="deal-actions">
                            <button class="btn-deal btn-deal-primary" onclick="addToCart(${deal.id})">
                                <i class="fas fa-shopping-cart"></i> Add to Cart
                            </button>
                            <button class="btn-deal btn-deal-secondary" onclick="viewProduct(${deal.id})">
                                <i class="fas fa-eye"></i> View Details
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Calculate progress percentage
        function calculateProgress(deal) {
            const totalStock = deal.stock + deal.sold_quantity;
            if (totalStock === 0) return 0;
            return Math.round((deal.sold_quantity / totalStock) * 100);
        }

        // Start countdown timer
        function startCountdown(event) {
            const countdownElement = document.getElementById('mainCountdown');
            const statusElement = document.getElementById('countdownStatus');
            
            countdownElement.style.display = 'flex';
            statusElement.style.display = 'none';

            countdownInterval = setInterval(() => {
                const now = new Date().getTime();
                const endTime = new Date(event.end_date).getTime();
                const distance = endTime - now;

                if (distance < 0) {
                    clearInterval(countdownInterval);
                    statusElement.style.display = 'block';
                    countdownElement.style.display = 'none';
                    return;
                }

                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                countdownElement.innerHTML = `
                    <div class="countdown-box">
                        <span class="countdown-number">${days}</span>
                        <span class="countdown-label">Days</span>
                    </div>
                    <div class="countdown-box">
                        <span class="countdown-number">${hours}</span>
                        <span class="countdown-label">Hours</span>
                    </div>
                    <div class="countdown-box">
                        <span class="countdown-number">${minutes}</span>
                        <span class="countdown-label">Minutes</span>
                    </div>
                    <div class="countdown-box">
                        <span class="countdown-number">${seconds}</span>
                        <span class="countdown-label">Seconds</span>
                    </div>
                `;
            }, 1000);
        }

        // Helper functions
        function formatPrice(price) {
            return new Intl.NumberFormat('en-KE', {
                style: 'currency',
                currency: 'KES',
                minimumFractionDigits: 0
            }).format(price);
        }

        // Product actions
        async function addToCart(productId) {
            if (!isLoggedIn) {
                alert('Please login to add products to cart.');
                window.location.href = '/login';
                return;
            }

            try {
                const response = await fetch('/api/cart/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        product_id: productId,
                        quantity: 1
                    })
                });

                const data = await response.json();
                
                if (data.success) {
                    alert('Product added to cart!');
                    updateCartCount();
                } else {
                    alert('Failed to add product to cart.');
                }
            } catch (error) {
                console.error('Error adding to cart:', error);
                alert('Error adding product to cart.');
            }
        }

        function viewProduct(productId) {
            window.location.href = `/product/${productId}`;
        }

        function showNoDeals(message) {
            const dealsGrid = document.getElementById('dealsGrid');
            dealsGrid.innerHTML = `
                <div class="no-deals">
                    <i class="fas fa-gift"></i>
                    <h3>No Deals Available</h3>
                    <p>${message}</p>
                    <a href="/categories" class="view-all-btn">Browse Categories</a>
                </div>
            `;
        }
    </script>
</body>
</html>