<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - OMUNJU SHOPPERS</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/admin-enhanced.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* Profile Page Specific Styles */
        .profile-hero {
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
            padding: 4rem 0;
            text-align: center;
            margin-bottom: 3rem;
        }

        .profile-hero h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .profile-hero p {
            font-size: 1.3rem;
            opacity: 0.9;
        }

        .profile-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Profile Header */
        .profile-header {
            background: white;
            padding: 2rem;
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 2rem;
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: var(--bg-color);
            overflow: hidden;
            border: 4px solid var(--secondary-color);
        }

        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .profile-info {
            flex: 1;
        }

        .profile-name {
            font-size: 2rem;
            font-weight: 700;
            color: var(--text-color);
            margin-bottom: 0.5rem;
        }

        .profile-email {
            color: #666;
            margin-bottom: 1rem;
        }

        .profile-meta {
            display: flex;
            gap: 2rem;
            font-size: 0.9rem;
            color: #666;
        }

        .profile-actions {
            display: flex;
            gap: 1rem;
        }

        .btn-profile {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

        .btn-profile-primary {
            background: var(--secondary-color);
            color: white;
        }

        .btn-profile-primary:hover {
            background: #2980b9;
        }

        .btn-profile-secondary {
            background: transparent;
            color: var(--text-color);
            border: 1px solid #ddd;
        }

        .btn-profile-secondary:hover {
            background: #f8f9fa;
            border-color: var(--text-color);
        }

        /* Profile Navigation */
        .profile-nav {
            background: white;
            padding: 1rem;
            border-radius: 8px;
            box-shadow: var(--shadow);
            margin-bottom: 2rem;
        }

        .profile-nav-tabs {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .profile-tab {
            padding: 1rem 2rem;
            border: none;
            border-radius: 4px;
            background: transparent;
            color: #666;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
            border-bottom: 2px solid transparent;
        }

        .profile-tab:hover {
            background: var(--bg-color);
            color: var(--text-color);
        }

        .profile-tab.active {
            background: var(--secondary-color);
            color: white;
            border-bottom-color: var(--secondary-color);
        }

        /* Profile Sections */
        .profile-section {
            background: white;
            border-radius: 8px;
            box-shadow: var(--shadow);
            overflow: hidden;
            margin-bottom: 2rem;
            display: none;
        }

        .profile-section.active {
            display: block;
        }

        .section-header {
            padding: 1.5rem;
            background: var(--bg-color);
            border-bottom: 1px solid #eee;
            font-weight: 700;
            color: var(--text-color);
        }

        .section-content {
            padding: 2rem;
        }

        /* Form Styles */
        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: var(--text-color);
        }

        .form-input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
            box-sizing: border-box;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 2px rgba(52, 152, 219, 0.2);
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
        }

        /* Profile Stats */
        .profile-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background: var(--bg-color);
            padding: 1.5rem;
            border-radius: 8px;
            text-align: center;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: bold;
            color: var(--secondary-color);
            display: block;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #666;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Order History */
        .order-list {
            display: grid;
            gap: 1rem;
        }

        .order-item {
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .order-info {
            display: flex;
            gap: 2rem;
            align-items: center;
        }

        .order-details h4 {
            margin: 0 0 0.5rem 0;
            color: var(--text-color);
        }

        .order-details p {
            margin: 0;
            color: #666;
            font-size: 0.9rem;
        }

        .order-status {
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: bold;
            text-transform: uppercase;
        }

        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-processing {
            background: #cff4fc;
            color: #055160;
        }

        .status-shipped {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-delivered {
            background: #d1e7dd;
            color: #0f5132;
        }

        .status-cancelled {
            background: #f8d7da;
            color: #721c24;
        }

        /* Address List */
        .address-list {
            display: grid;
            gap: 1rem;
        }

        .address-card {
            border: 1px solid #eee;
            border-radius: 8px;
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .address-info h4 {
            margin: 0 0 0.5rem 0;
            color: var(--text-color);
        }

        .address-info p {
            margin: 0;
            color: #666;
            line-height: 1.5;
        }

        .address-actions {
            display: flex;
            gap: 0.5rem;
        }

        .btn-address {
            padding: 0.25rem 0.75rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: white;
            cursor: pointer;
            font-size: 0.8rem;
            transition: all 0.3s ease;
        }

        .btn-address:hover {
            background: #f8f9fa;
            border-color: var(--text-color);
        }

        .btn-primary-action {
            background: var(--secondary-color);
            color: white;
            border-color: var(--secondary-color);
        }

        .btn-primary-action:hover {
            background: #2980b9;
            border-color: #2980b9;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem;
            color: #666;
        }

        .empty-state i {
            font-size: 3rem;
            color: #ddd;
            margin-bottom: 1rem;
        }

        /* Loading State */
        .loading-profile {
            text-align: center;
            padding: 3rem;
            color: var(--text-color);
        }

        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid var(--secondary-color);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .profile-hero h1 {
                font-size: 2.5rem;
            }

            .profile-header {
                flex-direction: column;
                text-align: center;
            }

            .profile-actions {
                width: 100%;
                justify-content: center;
            }

            .profile-nav-tabs {
                justify-content: center;
            }

            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- Enhanced Navigation -->
    <%- include('partials/navigation-enhanced', { currentPage: 'profile', user: user }) %>

    <!-- Profile Hero Section -->
    <section class="profile-hero">
        <div class="profile-container">
            <h1>My Profile</h1>
            <p>Manage your account, orders, and personal information</p>
        </div>
    </section>

    <!-- Main Content -->
    <main class="main-content">
        <div class="profile-container">
            <!-- Profile Header -->
            <section class="profile-header">
                <div class="profile-avatar">
                    <img src="<%= user && user.avatar ? user.avatar : '/images/default-avatar.jpg' %>" alt="Profile Avatar">
                </div>
                <div class="profile-info">
                    <h2 class="profile-name"><%= user ? user.name : 'Guest User' %></h2>
                    <p class="profile-email"><%= user ? user.email : 'guest@example.com' %></p>
                    <div class="profile-meta">
                        <span><i class="fas fa-user"></i> Member since <%= user ? new Date(user.created_at).getFullYear() : '2024' %></span>
                        <span><i class="fas fa-shopping-bag"></i> <span id="totalOrders">0</span> Orders</span>
                        <span><i class="fas fa-wallet"></i> KSh <span id="totalSpent">0</span> Spent</span>
                    </div>
                </div>
                <div class="profile-actions">
                    <button class="btn-profile btn-profile-secondary" onclick="openEditProfile()">
                        <i class="fas fa-edit"></i> Edit Profile
                    </button>
                    <button class="btn-profile btn-profile-primary" onclick="openChangePassword()">
                        <i class="fas fa-lock"></i> Change Password
                    </button>
                </div>
            </section>

            <!-- Profile Navigation -->
            <section class="profile-nav">
                <div class="profile-nav-tabs">
                    <button class="profile-tab active" onclick="showProfileSection('overview')">
                        <i class="fas fa-tachometer-alt"></i> Overview
                    </button>
                    <button class="profile-tab" onclick="showProfileSection('orders')">
                        <i class="fas fa-shopping-bag"></i> Order History
                    </button>
                    <button class="profile-tab" onclick="showProfileSection('addresses')">
                        <i class="fas fa-map-marker-alt"></i> Addresses
                    </button>
                    <button class="profile-tab" onclick="showProfileSection('security')">
                        <i class="fas fa-shield-alt"></i> Security
                    </button>
                    <button class="profile-tab" onclick="showProfileSection('preferences')">
                        <i class="fas fa-cog"></i> Preferences
                    </button>
                </div>
            </section>

            <!-- Profile Sections -->
            <section id="overview" class="profile-section active">
                <div class="section-header">
                    <i class="fas fa-tachometer-alt"></i> Account Overview
                </div>
                <div class="section-content">
                    <div class="profile-stats">
                        <div class="stat-card">
                            <span class="stat-number" id="statOrders">0</span>
                            <div class="stat-label">Total Orders</div>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number" id="statSpent">0</span>
                            <div class="stat-label">Total Spent</div>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number" id="statProducts">0</span>
                            <div class="stat-label">Products Bought</div>
                        </div>
                        <div class="stat-card">
                            <span class="stat-number" id="statWishlist">0</span>
                            <div class="stat-label">Wishlist Items</div>
                        </div>
                    </div>

                    <div class="profile-details">
                        <h3>Personal Information</h3>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Full Name</label>
                                <input type="text" class="form-input" value="<%= user ? user.name : '' %>" disabled>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Email Address</label>
                                <input type="email" class="form-input" value="<%= user ? user.email : '' %>" disabled>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Phone Number</label>
                                <input type="tel" class="form-input" value="<%= user ? user.phone : '' %>" disabled>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Date of Birth</label>
                                <input type="date" class="form-input" value="<%= user && user.date_of_birth ? user.date_of_birth.split('T')[0] : '' %>" disabled>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section id="orders" class="profile-section">
                <div class="section-header">
                    <i class="fas fa-shopping-bag"></i> Order History
                </div>
                <div class="section-content">
                    <div class="order-list" id="orderList">
                        <!-- Orders will be loaded here -->
                        <div class="loading-profile">
                            <div class="spinner"></div>
                            <p>Loading orders...</p>
                        </div>
                    </div>
                </div>
            </section>

            <section id="addresses" class="profile-section">
                <div class="section-header">
                    <i class="fas fa-map-marker-alt"></i> Saved Addresses
                </div>
                <div class="section-content">
                    <div class="address-list" id="addressList">
                        <!-- Addresses will be loaded here -->
                        <div class="loading-profile">
                            <div class="spinner"></div>
                            <p>Loading addresses...</p>
                        </div>
                    </div>
                    <div style="margin-top: 2rem;">
                        <button class="btn-profile btn-profile-primary" onclick="addNewAddress()">
                            <i class="fas fa-plus"></i> Add New Address
                        </button>
                    </div>
                </div>
            </section>

            <section id="security" class="profile-section">
                <div class="section-header">
                    <i class="fas fa-shield-alt"></i> Security Settings
                </div>
                <div class="section-content">
                    <div class="security-options">
                        <div class="form-group">
                            <label class="form-label">Password</label>
                            <div style="display: flex; gap: 1rem;">
                                <input type="password" class="form-input" value="••••••••••••••••" disabled>
                                <button class="btn-profile btn-profile-secondary" onclick="openChangePassword()">
                                    Change Password
                                </button>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Two-Factor Authentication</label>
                            <div style="display: flex; gap: 1rem; align-items: center;">
                                <input type="checkbox" id="twoFactorToggle" onchange="toggleTwoFactor()">
                                <span id="twoFactorStatus">Not enabled</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Active Sessions</label>
                            <div class="session-list" id="sessionList">
                                <!-- Sessions will be loaded here -->
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section id="preferences" class="profile-section">
                <div class="section-header">
                    <i class="fas fa-cog"></i> Account Preferences
                </div>
                <div class="section-content">
                    <div class="preferences-options">
                        <div class="form-group">
                            <label class="form-label">Email Notifications</label>
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                                <label style="display: flex; align-items: center; gap: 0.5rem;">
                                    <input type="checkbox" id="emailOrders" onchange="updatePreferences()">
                                    Order Updates
                                </label>
                                <label style="display: flex; align-items: center; gap: 0.5rem;">
                                    <input type="checkbox" id="emailPromotions" onchange="updatePreferences()">
                                    Promotions & Offers
                                </label>
                                <label style="display: flex; align-items: center; gap: 0.5rem;">
                                    <input type="checkbox" id="emailSecurity" onchange="updatePreferences()">
                                    Security Alerts
                                </label>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Theme Preferences</label>
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                                <label style="display: flex; align-items: center; gap: 0.5rem;">
                                    <input type="radio" name="theme" value="light" onchange="updateTheme()">
                                    Light Theme
                                </label>
                                <label style="display: flex; align-items: center; gap: 0.5rem;">
                                    <input type="radio" name="theme" value="dark" onchange="updateTheme()">
                                    Dark Theme
                                </label>
                                <label style="display: flex; align-items: center; gap: 0.5rem;">
                                    <input type="radio" name="theme" value="auto" onchange="updateTheme()">
                                    Auto (System)
                                </label>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Privacy Settings</label>
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
                                <label style="display: flex; align-items: center; gap: 0.5rem;">
                                    <input type="checkbox" id="shareData" onchange="updatePreferences()">
                                    Share data for personalized experience
                                </label>
                                <label style="display: flex; align-items: center; gap: 0.5rem;">
                                    <input type="checkbox" id="rememberSearch" onchange="updatePreferences()">
                                    Remember search history
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- Footer -->
    <%- include('partials/footer') %>

    <!-- Scripts -->
    <script>
        // Profile Page JavaScript
        let userProfile = {};
        let userOrders = [];
        let userAddresses = [];
        let userSessions = [];

        // Initialize page
        document.addEventListener('DOMContentLoaded', () => {
            loadProfileData();
            setupEventListeners();
        });

        // Setup event listeners
        function setupEventListeners() {
            // Search functionality
            const searchInput = document.getElementById('globalSearch');
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    const searchTerm = e.target.value.toLowerCase();
                    if (searchTerm.length > 2) {
                        filterOrders(searchTerm);
                    } else if (searchTerm.length === 0) {
                        renderOrders(userOrders);
                    }
                });
            }
        }

        // Load profile data
        async function loadProfileData() {
            try {
                // Load user profile
                const profileResponse = await fetch('/api/profile');
                const profileData = await profileResponse.json();

                if (profileData.success) {
                    userProfile = profileData.user;
                    updateProfileHeader();
                    updateStats();
                }

                // Load orders
                const ordersResponse = await fetch('/api/orders');
                const ordersData = await ordersResponse.json();

                if (ordersData.success) {
                    userOrders = ordersData.orders;
                    renderOrders(userOrders);
                }

                // Load addresses
                const addressesResponse = await fetch('/api/addresses');
                const addressesData = await addressesResponse.json();

                if (addressesData.success) {
                    userAddresses = addressesData.addresses;
                    renderAddresses(userAddresses);
                }

                // Load sessions
                const sessionsResponse = await fetch('/api/sessions');
                const sessionsData = await sessionsResponse.json();

                if (sessionsData.success) {
                    userSessions = sessionsData.sessions;
                    renderSessions(userSessions);
                }

                // Load preferences
                loadPreferences();
            } catch (error) {
                console.error('Error loading profile data:', error);
            }
        }

        // Update profile header
        function updateProfileHeader() {
            // This would update the header with user data
            // Implementation depends on your user system
        }

        // Update statistics
        function updateStats() {
            const totalOrders = userOrders.length;
            const totalSpent = userOrders.reduce((sum, order) => sum + (order.total || 0), 0);
            const uniqueProducts = new Set();
            
            userOrders.forEach(order => {
                if (order.items) {
                    order.items.forEach(item => uniqueProducts.add(item.product_id));
                }
            });

            document.getElementById('statOrders').textContent = totalOrders;
            document.getElementById('statSpent').textContent = formatPrice(totalSpent);
            document.getElementById('statProducts').textContent = uniqueProducts.size;
            document.getElementById('statWishlist').textContent = '0'; // Would need wishlist API
        }

        // Show profile section
        function showProfileSection(sectionId) {
            // Hide all sections
            document.querySelectorAll('.profile-section').forEach(section => {
                section.classList.remove('active');
            });

            // Show selected section
            document.getElementById(sectionId).classList.add('active');

            // Update tab styles
            document.querySelectorAll('.profile-tab').forEach(tab => {
                tab.classList.remove('active');
            });

            // Find and activate the clicked tab
            const clickedTab = event.target.closest('.profile-tab');
            if (clickedTab) {
                clickedTab.classList.add('active');
            }
        }

        // Render orders
        function renderOrders(ordersToShow) {
            const orderList = document.getElementById('orderList');

            if (ordersToShow.length === 0) {
                orderList.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-shopping-bag"></i>
                        <h3>No Orders Found</h3>
                        <p>You haven't placed any orders yet. Start shopping to see your order history here.</p>
                        <a href="/categories" class="btn-profile btn-profile-primary">
                            <i class="fas fa-shopping-bag"></i> Start Shopping
                        </a>
                    </div>
                `;
                return;
            }

            orderList.innerHTML = ordersToShow.map(order => `
                <div class="order-item">
                    <div class="order-info">
                        <div class="order-image">
                            <img src="${order.items && order.items[0] ? order.items[0].image_url : '/images/default-product.jpg'}" 
                                 alt="Order ${order.id}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px;">
                        </div>
                        <div class="order-details">
                            <h4>Order #${order.id}</h4>
                            <p>Placed on ${formatDate(order.created_at)}</p>
                            <p>${order.items ? order.items.length : 0} items • ${formatPrice(order.total || 0)}</p>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <span class="order-status ${getOrderStatusClass(order.status)}">
                            ${order.status || 'Unknown'}
                        </span>
                        <div style="margin-top: 0.5rem;">
                            <button class="btn-address" onclick="viewOrderDetails('${order.id}')">
                                <i class="fas fa-eye"></i> View Details
                            </button>
                            ${order.status === 'pending' ? `
                                <button class="btn-address" onclick="cancelOrder('${order.id}')">
                                    <i class="fas fa-times"></i> Cancel
                                </button>
                            ` : ''}
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Render addresses
        function renderAddresses(addressesToShow) {
            const addressList = document.getElementById('addressList');

            if (addressesToShow.length === 0) {
                addressList.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-map-marker-alt"></i>
                        <h3>No Addresses Saved</h3>
                        <p>Add your shipping addresses to make checkout faster and easier.</p>
                    </div>
                `;
                return;
            }

            addressList.innerHTML = addressesToShow.map(address => `
                <div class="address-card">
                    <div class="address-info">
                        <h4>${address.type || 'Shipping Address'}</h4>
                        <p>${address.street}, ${address.city}</p>
                        <p>${address.state}, ${address.country}</p>
                        <p>Postal Code: ${address.postal_code}</p>
                        ${address.is_default ? '<span class="order-status status-processing">Default Address</span>' : ''}
                    </div>
                    <div class="address-actions">
                        <button class="btn-address" onclick="editAddress('${address.id}')">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button class="btn-address" onclick="deleteAddress('${address.id}')">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                        ${!address.is_default ? `
                            <button class="btn-address btn-primary-action" onclick="setDefaultAddress('${address.id}')">
                                <i class="fas fa-star"></i> Set Default
                            </button>
                        ` : ''}
                    </div>
                </div>
            `).join('');
        }

        // Render sessions
        function renderSessions(sessionsToShow) {
            const sessionList = document.getElementById('sessionList');

            if (sessionsToShow.length === 0) {
                sessionList.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-desktop"></i>
                        <p>No active sessions found.</p>
                    </div>
                `;
                return;
            }

            sessionList.innerHTML = sessionsToShow.map(session => `
                <div style="border: 1px solid #eee; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <strong>${session.device || 'Unknown Device'}</strong>
                            <p style="margin: 0.5rem 0 0 0; color: #666;">${session.ip_address} • ${formatDate(session.created_at)}</p>
                        </div>
                        <div>
                            ${session.is_current ? `
                                <span class="order-status status-processing">Current Session</span>
                            ` : `
                                <button class="btn-address" onclick="logoutSession('${session.id}')">
                                    <i class="fas fa-sign-out-alt"></i> Logout
                                </button>
                            `}
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // Filter orders
        function filterOrders(searchTerm) {
            const filteredOrders = userOrders.filter(order => 
                order.id.toString().includes(searchTerm) ||
                (order.items && order.items.some(item => 
                    item.name && item.name.toLowerCase().includes(searchTerm)
                ))
            );
            renderOrders(filteredOrders);
        }

        // Helper functions
        function getOrderStatusClass(status) {
            switch (status) {
                case 'pending': return 'status-pending';
                case 'processing': return 'status-processing';
                case 'shipped': return 'status-shipped';
                case 'delivered': return 'status-delivered';
                case 'cancelled': return 'status-cancelled';
                default: return 'status-pending';
            }
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('en-KE', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
            });
        }

        function formatPrice(price) {
            return new Intl.NumberFormat('en-KE', {
                style: 'currency',
                currency: 'KES',
                minimumFractionDigits: 0
            }).format(price);
        }

        // Profile actions
        function openEditProfile() {
            alert('Edit profile functionality would open a modal or redirect to edit page.');
        }

        function openChangePassword() {
            alert('Change password functionality would open a modal or redirect to password change page.');
        }

        function addNewAddress() {
            alert('Add new address functionality would open a modal or redirect to address form.');
        }

        function editAddress(addressId) {
            alert(`Edit address ${addressId} functionality would open a modal or redirect to edit form.`);
        }

        function deleteAddress(addressId) {
            if (confirm('Are you sure you want to delete this address?')) {
                // API call to delete address
                alert(`Address ${addressId} deleted.`);
            }
        }

        function setDefaultAddress(addressId) {
            // API call to set default address
            alert(`Address ${addressId} set as default.`);
        }

        function viewOrderDetails(orderId) {
            window.location.href = `/order/${orderId}`;
        }

        function cancelOrder(orderId) {
            if (confirm('Are you sure you want to cancel this order?')) {
                // API call to cancel order
                alert(`Order ${orderId} cancelled.`);
            }
        }

        function logoutSession(sessionId) {
            if (confirm('Are you sure you want to logout this session?')) {
                // API call to logout session
                alert(`Session ${sessionId} logged out.`);
            }
        }

        function toggleTwoFactor() {
            const isChecked = document.getElementById('twoFactorToggle').checked;
            alert(`Two-factor authentication ${isChecked ? 'enabled' : 'disabled'}.`);
        }

        function updatePreferences() {
            alert('Preferences updated successfully.');
        }

        function updateTheme() {
            const selectedTheme = document.querySelector('input[name="theme"]:checked').value;
            alert(`Theme changed to ${selectedTheme}.`);
        }

        function loadPreferences() {
            // Load user preferences from localStorage or API
            // Set checkbox states based on preferences
        }
    </script>
</body>
