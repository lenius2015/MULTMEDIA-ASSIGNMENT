<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/checkout.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Header -->
    <header class="checkout-header">
        <div class="container">
            <a href="/" class="logo">
                <i class="fas fa-store"></i>
                <span>OMUNJU SHOPPERS</span>
            </a>
            <div class="secure-badge">
                <i class="fas fa-lock"></i>
                <span>Secure Checkout</span>
            </div>
        </div>
    </header>

    <!-- Progress Steps -->
    <div class="progress-bar">
        <div class="container">
            <div class="steps">
                <div class="step active" data-step="cart">
                    <div class="step-number">1</div>
                    <span>Cart</span>
                </div>
                <div class="step-line"></div>
                <div class="step" data-step="details">
                    <div class="step-number">2</div>
                    <span>Details</span>
                </div>
                <div class="step-line"></div>
                <div class="step" data-step="delivery">
                    <div class="step-number">3</div>
                    <span>Delivery</span>
                </div>
                <div class="step-line"></div>
                <div class="step" data-step="payment">
                    <div class="step-number">4</div>
                    <span>Payment</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main class="checkout-main">
        <div class="container">
            <form id="checkoutForm">
                <div class="checkout-grid">
                    <!-- Left Column - Forms -->
                    <div class="checkout-forms">
                        
                        <!-- Step 1: Cart Items -->
                        <section class="checkout-section" id="section-cart">
                            <div class="section-header">
                                <h2><i class="fas fa-shopping-cart"></i> Shopping Cart</h2>
                            </div>
                            <div class="section-body">
                                <% if (cartItems && cartItems.length > 0) { %>
                                    <div class="cart-items-list">
                                        <% cartItems.forEach((item, index) => { %>
                                        <div class="cart-item-row" data-product-id="<%= item.product_id %>">
                                            <div class="item-image">
                                                <img src="<%= item.image_url || '/images/product-placeholder.jpg' %>" 
                                                     alt="<%= item.name %>"
                                                     onerror="this.src='/images/product-placeholder.jpg'">
                                            </div>
                                            <div class="item-details">
                                                <h4><%= item.name %></h4>
                                                <p class="item-price">$<%= item.price.toFixed(2) %></p>
                                                <% if (item.stock <= 5) { %>
                                                    <span class="stock-warning">Only <%= item.stock %> left</span>
                                                <% } %>
                                            </div>
                                            <div class="item-quantity">
                                                <button type="button" class="qty-btn" onclick="updateQty(<%= index %>, -1)">-</button>
                                                <input type="number" name="items[<%= index %>][quantity]" 
                                                       value="<%= item.quantity %>" 
                                                       min="1" max="<%= item.stock %>"
                                                       class="qty-input"
                                                       data-price="<%= item.price %>"
                                                       onchange="updateItemTotal(this, <%= index %>)">
                                                <button type="button" class="qty-btn" onclick="updateQty(<%= index %>, 1)">+</button>
                                            </div>
                                            <div class="item-subtotal">
                                                $<span id="item-subtotal-<%= index %>"><%= (item.price * item.quantity).toFixed(2) %></span>
                                            </div>
                                            <button type="button" class="btn-remove" onclick="removeItem(<%= item.product_id %>)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                            <input type="hidden" name="items[<%= index %>][product_id]" value="<%= item.product_id %>">
                                            <input type="hidden" name="items[<%= index %>][name]" value="<%= item.name %>">
                                            <input type="hidden" name="items[<%= index %>][price]" value="<%= item.price %>">
                                            <input type="hidden" name="items[<%= index %>][quantity]" value="<%= item.quantity %>">
                                        </div>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <div class="empty-cart">
                                        <i class="fas fa-shopping-cart"></i>
                                        <h3>Your cart is empty</h3>
                                        <p>Add some products to continue</p>
                                        <a href="/products" class="btn btn-primary">Browse Products</a>
                                    </div>
                                <% } %>
                            </div>
                        </section>

                        <!-- Step 2: Customer Details -->
                        <section class="checkout-section" id="section-details">
                            <div class="section-header">
                                <h2><i class="fas fa-user"></i> Customer Information</h2>
                            </div>
                            <div class="section-body">
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="customer_name">Full Name *</label>
                                        <input type="text" id="customer_name" name="customer_name" 
                                               value="<%= user ? user.name : '' %>" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="customer_email">Email Address *</label>
                                        <input type="email" id="customer_email" name="customer_email" 
                                               value="<%= user ? user.email : '' %>" required>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="customer_phone">Phone Number *</label>
                                        <input type="tel" id="customer_phone" name="customer_phone" 
                                               value="<%= user ? user.phone || '' : '' %>" 
                                               placeholder="+255 7XX XXX XXX" required>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Step 3: Delivery Address -->
                        <section class="checkout-section" id="section-delivery">
                            <div class="section-header">
                                <h2><i class="fas fa-truck"></i> Delivery Address</h2>
                            </div>
                            <div class="section-body">
                                <!-- Saved Addresses -->
                                <% if (addresses && addresses.length > 0) { %>
                                <div class="saved-addresses">
                                    <h4>Use saved address</h4>
                                    <div class="addresses-grid">
                                        <% addresses.forEach((addr, index) => { %>
                                        <div class="address-card" onclick="useAddress('<%= index %>')" data-index="<%= index %>">
                                            <input type="radio" name="use_saved_address" value="<%= index %>">
                                            <div class="address-content">
                                                <strong><%= addr.label || 'Address ' + (index + 1) %></strong>
                                                <p><%= addr.street_address %></p>
                                                <p><%= addr.city %>, <%= addr.region %></p>
                                            </div>
                                        </div>
                                        <% }); %>
                                    </div>
                                </div>
                                <% } %>

                                <!-- New Address Form -->
                                <div class="form-row">
                                    <div class="form-group full-width">
                                        <label for="shipping_address">Street Address *</label>
                                        <textarea id="shipping_address" name="shipping_address" rows="2" 
                                                  placeholder="Enter your full street address" required></textarea>
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="city">City *</label>
                                        <select id="city" name="city" onchange="updateDeliveryFee()" required>
                                            <option value="">Select City</option>
                                            <% zones.forEach(zone => { %>
                                                <option value="<%= zone %>" <%= user && user.city === zone ? 'selected' : '' %>>
                                                    <%= zone %>
                                                </option>
                                            <% }); %>
                                            <option value="Other">Other Location</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label for="region">Region/State</label>
                                        <input type="text" id="region" name="region" 
                                               value="<%= user ? user.region || '' : '' %>">
                                    </div>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label for="zip_code">ZIP Code</label>
                                        <input type="text" id="zip_code" name="zip_code">
                                    </div>
                                    <div class="form-group">
                                        <label for="country">Country</label>
                                        <input type="text" id="country" name="country" value="Tanzania">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="delivery_notes">Delivery Notes (Optional)</label>
                                    <textarea id="delivery_notes" name="delivery_notes" rows="2" 
                                              placeholder="Any special instructions for delivery..."></textarea>
                                </div>

                                <!-- Delivery Methods -->
                                <div class="delivery-methods">
                                    <h4><i class="fas fa-shipping-fast"></i> Delivery Method</h4>
                                    <div class="methods-grid">
                                        <label class="method-card">
                                            <input type="radio" name="delivery_method" value="home_delivery" 
                                                   checked onchange="updateDeliveryFee()">
                                            <div class="method-content">
                                                <i class="fas fa-home"></i>
                                                <strong>Home Delivery</strong>
                                                <p>Delivery to your doorstep</p>
                                                <span class="delivery-estimate">3-5 business days</span>
                                            </div>
                                        </label>
                                        <label class="method-card">
                                            <input type="radio" name="delivery_method" value="pickup_point" 
                                                   onchange="updateDeliveryFee()">
                                            <div class="method-content">
                                                <i class="fas fa-store"></i>
                                                <strong>Pickup Point</strong>
                                                <p>Collect from nearest point</p>
                                                <span class="delivery-estimate">1-2 business days</span>
                                            </div>
                                        </label>
                                        <label class="method-card express">
                                            <input type="radio" name="delivery_method" value="express" 
                                                   onchange="updateDeliveryFee()">
                                            <div class="method-content">
                                                <i class="fas fa-bolt"></i>
                                                <strong>Express Delivery</strong>
                                                <p>Fast delivery service</p>
                                                <span class="delivery-estimate">Same day / Next day</span>
                                            </div>
                                        </label>
                                    </div>
                                </div>

                                <!-- Pickup Details (shown when pickup selected) -->
                                <div id="pickup-details" class="pickup-details" style="display: none;">
                                    <div class="form-group">
                                        <label for="pickup_location">Select Pickup Point</label>
                                        <select id="pickup_location" name="pickup_location">
                                            <option value="">Select location</option>
                                            <option value="dar_main">Dar es Salaam - Main Office</option>
                                            <option value="dar_mlimani">Dar es Salaam - Mlimani City</option>
                                            <option value="arusha">Arusha - City Center</option>
                                            <option value="mwanza">Mwanza - Business District</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label for="pickup_contact">Contact Person</label>
                                        <input type="text" id="pickup_contact" name="pickup_contact" 
                                               placeholder="Who will collect the order?">
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Step 4: Payment -->
                        <section class="checkout-section" id="section-payment">
                            <div class="section-header">
                                <h2><i class="fas fa-credit-card"></i> Payment Method</h2>
                            </div>
                            <div class="section-body">
                                <div class="payment-methods">
                                    <% paymentMethods.forEach(method => { %>
                                    <label class="payment-card">
                                        <input type="radio" name="payment_method" value="<%= method.method_code %>" 
                                               data-fee="<%= method.processing_fee %>"
                                               <%= method.method_code === 'mpesa' ? 'checked' : '' %>>
                                        <div class="payment-content">
                                            <div class="payment-icon">
                                                <% if (method.method_code === 'mpesa') { %>
                                                    <i class="fas fa-mobile-alt"></i>
                                                <% } else if (method.method_code.includes('tigo') || method.method_code.includes('airtel') || method.method_code.includes('halo')) { %>
                                                    <i class="fas fa-phone"></i>
                                                <% } else if (method.method_code === 'bank_card') { %>
                                                    <i class="fas fa-credit-card"></i>
                                                <% } else { %>
                                                    <i class="fas fa-money-bill-wave"></i>
                                                <% } %>
                                            </div>
                                            <div class="payment-info">
                                                <strong><%= method.method_name %></strong>
                                                <% if (method.processing_fee > 0) { %>
                                                    <span class="fee-badge">+<%= method.processing_fee %>% fee</span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <% if (method.instructions) { %>
                                        <p class="payment-instructions"><%= method.instructions %></p>
                                        <% } %>
                                    </label>
                                    <% }); %>
                                </div>

                                <!-- Promo Code -->
                                <div class="promo-section">
                                    <h4><i class="fas fa-tag"></i> Have a Promo Code?</h4>
                                    <div class="promo-input-group">
                                        <input type="text" id="promo_code" name="promocode_code" 
                                               placeholder="Enter code">
                                        <button type="button" class="btn btn-secondary" onclick="applyPromo()">
                                            Apply
                                        </button>
                                    </div>
                                    <div id="promo-message" class="promo-message"></div>
                                    <input type="hidden" id="discount_amount" name="discount_amount" value="0">
                                </div>
                            </div>
                        </section>
                    </div>

                    <!-- Right Column - Order Summary -->
                    <div class="order-summary">
                        <div class="summary-card">
                            <h3>Order Summary</h3>
                            
                            <div class="summary-items">
                                <% cartItems.forEach((item, index) => { %>
                                <div class="summary-item">
                                    <div class="item-thumb">
                                        <img src="<%= item.image_url || '/images/product-placeholder.jpg' %>" 
                                             alt="<%= item.name %>">
                                        <span class="item-qty"><%= item.quantity %></span>
                                    </div>
                                    <span class="item-name"><%= item.name %></span>
                                    <span class="item-price">$<%= (item.price * item.quantity).toFixed(2) %></span>
                                </div>
                                <% }); %>
                            </div>

                            <div class="summary-totals">
                                <div class="total-row">
                                    <span>Subtotal</span>
                                    <span id="summary-subtotal">$<%= totals.subtotal %></span>
                                </div>
                                <div class="total-row">
                                    <span>Delivery Fee</span>
                                    <span id="summary-delivery">$<%= totals.deliveryFee %></span>
                                </div>
                                <div class="total-row">
                                    <span>Tax (18%)</span>
                                    <span id="summary-tax">$<%= totals.tax %></span>
                                </div>
                                <div class="total-row discount" id="discount-row" style="display: none;">
                                    <span>Discount</span>
                                    <span id="summary-discount">-$0.00</span>
                                </div>
                                <div class="total-row grand-total">
                                    <span>Total</span>
                                    <span id="summary-total">$<%= totals.total %></span>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-block btn-lg" id="submitBtn">
                                <i class="fas fa-lock"></i>
                                <span>Complete Order</span>
                                <span id="total-amount">$<%= totals.total %></span>
                            </button>

                            <div class="security-badges">
                                <span><i class="fas fa-shield-alt"></i> SSL Secured</span>
                                <span><i class="fas fa-lock"></i> PCI Compliant</span>
                            </div>

                            <div class="accepted-payments">
                                <p>We accept:</p>
                                <div class="payment-icons">
                                    <i class="fab fa-cc-visa"></i>
                                    <i class="fab fa-cc-mastercard"></i>
                                    <i class="fas fa-mobile-alt"></i>
                                    <span>M-Pesa</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </main>

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="spinner"></div>
        <p>Processing your order...</p>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toast-container"></div>

    <script src="/checkout.js"></script>
    <script>
        // Initialize checkout
        document.addEventListener('DOMContentLoaded', function() {
            initCheckout();
        });
    </script>
</body>
</html>
